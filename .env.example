# Resend (required for contact form)
RESEND_API_KEY=re_xxxxxxxx

# Where inquiries are delivered (defaults to interiors@colorsofdesign.com)
CONTACT_TO_EMAIL=interiors@colorsofdesign.com

# Must be a verified sender in Resend.
# Until your domain is verified, you can use: Colors of Design <onboarding@resend.dev>
# After verifying colorsofdesign.com, prefer something like:
# CONTACT_FROM_EMAIL=Colors of Design <interiors@colorsofdesign.com>
CONTACT_FROM_EMAIL=Colors of Design <onboarding@resend.dev>

# Cloudflare Turnstile (recommended anti-spam protection)
# Public site key is embedded in the form; secret key is used only by the API.
PUBLIC_TURNSTILE_SITE_KEY=your_site_key
TURNSTILE_SECRET_KEY=your_secret_key
