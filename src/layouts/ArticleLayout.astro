---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import JournalPreview from '../components/JournalPreview.astro';
import { site, absoluteUrl } from '../data/site';
import { getLocale, localizedPath } from '../i18n/locale';
import { pageCopy } from '../i18n/pages';
import { copy } from '../i18n/ui';
import { localizeJournal } from '../i18n/content';

const { frontmatter } = Astro.props;
const { title, description, category, image, imageAlt, canonicalPath } = frontmatter;
const locale = getLocale(Astro.url.pathname);
const pages = pageCopy(locale);
const t = copy(locale);
const related = localizeJournal(locale).filter((post) => post.url !== localizedPath(locale, canonicalPath));
---
<BaseLayout
	openGraphType="article"
	title={`${title} | Colors of Design`}
	description={description}
	image={image}
	canonicalPath={localizedPath(locale, canonicalPath)}
	jsonLd={{
		'@type': 'BlogPosting',
		headline: title,
		description,
		image: absoluteUrl(image),
		inLanguage: locale,
		mainEntityOfPage: absoluteUrl(localizedPath(locale, canonicalPath)),
		author: { '@type': 'Organization', name: site.name, url: absoluteUrl(localizedPath(locale, '/about-us/')) },
		publisher: { '@id': `${site.url}/#studio` },
	}}
>
	<main class="page" id="main">
		<div class="editorial-container">
			<header class="article-header">
				<Breadcrumbs
					items={[
						{ label: t.home, href: localizedPath(locale, '/') },
						{ label: t.crumbs.journal, href: localizedPath(locale, '/interior-design-blog/') },
						{ label: title },
					]}
				/>
				<p class="eyebrow">{category} · Colors of Design</p>
				<h1>{title}</h1>
				<p class="lead">{description}</p>
			</header>
			<figure class="article-hero">
				<img class="wide-image" src={image} alt={imageAlt} width="2000" height="1334" />
			</figure>
			<article class="article-body">
				<slot />
				<p>
					<a href={localizedPath(locale, '/contact-us/')}>{pages.journal.articleCta1}</a>{pages.journal.articleCtaMid}
					<a href={localizedPath(locale, '/work/')}>{pages.journal.articleCta2}</a>{pages.journal.articleCtaEnd}
				</p>
			</article>
		</div>
		<aside class="earth editorial-section">
			<JournalPreview related posts={related} eyebrow={pages.journal.continueReading} />
		</aside>
	</main>
</BaseLayout>
