---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import {journalPosts} from '../data/journal';
import {site, absoluteUrl} from '../data/site';
const {frontmatter} = Astro.props;
const {title, description, category, image, imageAlt, canonicalPath} = frontmatter;
const related = journalPosts.filter(post => post.url !== canonicalPath);
---
<BaseLayout openGraphType="article" title={`${title} | Colors of Design`} description={description} image={image} canonicalPath={canonicalPath} jsonLd={{'@type':'BlogPosting', headline:title, description, image:absoluteUrl(image), mainEntityOfPage:absoluteUrl(canonicalPath), author:{'@type':'Organization', name:site.name, url:absoluteUrl('/about-us/')}, publisher:{'@id':`${site.url}/#studio`}}}>
  <main class="page" id="main"><div class="editorial-container"><header class="article-header"><Breadcrumbs items={[{label:'Home', href:'/'},{label:'Journal',href:'/interior-design-blog/'},{label:title}]} /><p class="eyebrow">{category} · Colors of Design</p><h1>{title}</h1><p class="lead">{description}</p></header><figure><img class="wide-image" src={image} alt={imageAlt} width="2000" height="1334" /></figure><article class="article-body"><slot /><p><a href="/contact-us/">Tell us about your home</a> or explore <a href="/work/">our residential portfolio</a> to see these ideas in practice.</p></article></div><aside class="earth editorial-section"><div class="editorial-container"><p class="eyebrow">Continue reading</p>{related.map(post=><div class="editorial-copy" style="margin-top:1rem"><h2><a href={post.url}>{post.title}</a></h2><a class="text-link" href={post.url}>Read the story</a></div>)}</div></aside></main>
</BaseLayout>
