---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ConversionSection from '../../components/ConversionSection.astro';
import ShopGrid from '../../components/ShopGrid.astro';
import { shopBasePath } from '../../data/shop';
import { absoluteUrl, site } from '../../data/site';
import { getLocale, localizedPath } from '../../i18n/locale';
import { pageCopy } from '../../i18n/pages';
import { copy } from '../../i18n/ui';
import { localizeShopProducts } from '../../i18n/content';

const locale = getLocale(Astro.url.pathname);
const pages = pageCopy(locale);
const t = copy(locale);
const products = localizeShopProducts(locale);
const title = pages.shop.title;
const description = pages.shop.description;
const pageUrl = absoluteUrl(localizedPath(locale, `${shopBasePath}/`));
---

<BaseLayout
	title={title}
	description={description}
	canonicalPath={localizedPath(locale, `${shopBasePath}/`)}
	jsonLd={{
		'@type': 'CollectionPage',
		name: title,
		description,
		url: pageUrl,
		isPartOf: { '@id': `${site.url}/#website` },
		mainEntity: {
			'@type': 'ItemList',
			name: pages.shop.listName,
			numberOfItems: products.length,
			itemListElement: products.map((product, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				url: absoluteUrl(localizedPath(locale, `${shopBasePath}/${product.slug}/`)),
				name: product.name,
			})),
		},
	}}
>
	<main class="page" id="main">
		<div class="shop-page">
			<div class="shop-page__crumbs">
				<Breadcrumbs items={[{ label: t.home, href: localizedPath(locale, '/') }, { label: t.crumbs.shop }]} />
			</div>
			<ShopGrid fullPage headingLevel="h1" centerHeaderOnDesktop heading={pages.shop.heading} description={pages.shop.descriptionPage} eyebrow={pages.shop.eyebrow} />
		</div>
		<ConversionSection />
	</main>
</BaseLayout>

<style>
	.shop-page {
		background-color: var(--color-bg);
		--hero-max-width: 1400px;
	}

	.shop-page__crumbs {
		width: 100%;
		max-width: var(--hero-max-width);
		margin-inline: auto;
		padding: 2rem var(--site-gutter) 0;
	}
</style>
