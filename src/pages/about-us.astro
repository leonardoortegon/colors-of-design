---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TeamMember from '../components/TeamMember.astro';
import ConversionSection from '../components/ConversionSection.astro';
import { site, absoluteUrl } from '../data/site';
import { getLocale, localizedPath } from '../i18n/locale';
import { pageCopy } from '../i18n/pages';
import { copy } from '../i18n/ui';
import { localizeTeam } from '../i18n/content';

const locale = getLocale(Astro.url.pathname);
const pages = pageCopy(locale);
const t = copy(locale);
const teamMembers = localizeTeam(locale);
const aboutPath = localizedPath(locale, '/about-us/');
---

<BaseLayout
	title={pages.about.title}
	description={pages.about.description}
	canonicalPath={aboutPath}
	image="/margaret.jpg"
	jsonLd={{
		'@type': 'AboutPage',
		url: absoluteUrl(aboutPath),
		name: pages.about.jsonName,
		about: { '@id': `${site.url}/#studio` },
	}}
>
	<main class="page" id="main">
		<header class="about-hero">
			<div class="editorial-container">
				<Breadcrumbs items={[{ label: t.home, href: localizedPath(locale, '/') }, { label: t.crumbs.studio }]} />
				<div class="about-hero__grid editorial-grid">
					<div class="editorial-copy about-hero__lead">
						<h1>{pages.about.h1}</h1>
						<p>
							{pages.about.lead}
						</p>
					</div>
					<div class="editorial-copy about-hero__body">
						<p>
							{pages.about.p1}
						</p>
						<p>
							{pages.about.p2}
						</p>
						<a class="text-link" href={localizedPath(locale, '/work/')}>{pages.about.exploreWork}</a>
					</div>
				</div>
			</div>
		</header>

		<section class="about-team-intro-section editorial-section">
			<div class="editorial-container about-team-intro">
				<p class="eyebrow">{pages.about.teamEyebrow}</p>
				<h2 class="section-heading">{pages.about.teamHeading}</h2>
				<p class="about-team-intro__lead">
					{pages.about.teamLead}
				</p>
			</div>
		</section>

		{teamMembers.map((member) => (
			<TeamMember {...member} />
		))}

		<section class="about-perspective editorial-section">
			<div class="editorial-container about-perspective__inner">
				<p class="eyebrow">{pages.about.perspectiveEyebrow}</p>
				<h2 class="about-perspective__heading">{pages.about.perspectiveHeading}</h2>
				<p class="about-perspective__copy">
					{pages.about.perspectiveCopy}
				</p>
				<a class="text-link" href={localizedPath(locale, '/work-process/')}>{pages.about.discoverProcess}</a>
			</div>
		</section>

		<ConversionSection />
	</main>
</BaseLayout>

<style>
	.about-hero,
	.about-team-intro-section,
	.about-perspective {
		background-color: var(--color-bg);
	}

	.about-hero {
		padding: 2rem 0 clamp(3.5rem, 7vw, 6rem);
	}

	.about-hero__grid {
		padding-top: clamp(2rem, 5vw, 4rem);
		align-items: start;
		gap: clamp(3rem, 8vw, 8rem);
	}

	.about-hero__grid .editorial-copy {
		max-width: none;
	}

	.about-hero__lead h1 {
		font-family: var(--font-heading);
		font-weight: 400;
		font-size: clamp(2.8rem, 5.2vw, 4.8rem);
		line-height: 1.07;
		letter-spacing: -0.025em;
		margin: 0 0 1.5rem;
		text-wrap: balance;
	}

	.about-hero__body > p:first-child {
		margin-top: 0;
	}

	.about-team-intro {
		max-width: 44rem;
	}

	.about-team-intro .section-heading {
		margin-top: 1.25rem;
	}

	.about-team-intro__lead {
		margin-top: 1.25rem;
		color: var(--color-text-muted);
		line-height: 1.85;
		max-width: 36rem;
	}

	.about-perspective__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		max-width: 40rem;
		margin-inline: auto;
	}

	.about-perspective__inner .eyebrow {
		margin-bottom: 1.25rem;
	}

	.about-perspective__heading {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 3vw, 3rem);
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.02em;
		white-space: pre-line;
	}

	.about-perspective__copy {
		margin-top: 1.25rem;
		color: var(--color-text-muted);
		line-height: 1.85;
	}

	.about-perspective__inner .text-link {
		margin-top: 1.75rem;
	}
</style>
