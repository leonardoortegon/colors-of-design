---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TeamMember from '../components/TeamMember.astro';
import ConversionSection from '../components/ConversionSection.astro';
import { teamMembers } from '../data/team';
import { site, absoluteUrl } from '../data/site';
---

<BaseLayout
	title="About Our Miami Interior Design Studio | Colors of Design"
	description="Meet Margaret Van Puffelen, William Riveros, Ulysses, and the Colors of Design team—a Miami interior design studio with an artistic perspective and a personal approach to residential interiors."
	canonicalPath="/about-us/"
	image="/margaret.jpg"
	jsonLd={{
		'@type': 'AboutPage',
		url: absoluteUrl('/about-us/'),
		name: 'About Colors of Design',
		about: { '@id': `${site.url}/#studio` },
	}}
>
	<main class="page" id="main">
		<header class="about-hero">
			<div class="editorial-container">
				<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Studio' }]} />
				<div class="about-hero__grid editorial-grid">
					<div class="editorial-copy about-hero__lead">
						<h1>Vision and purpose.</h1>
						<p>
							Colors of Design creates harmonious, modern, and timeless homes throughout the United States.
							From early plans to final installation, we shape each project as a thoughtful and personal whole.
						</p>
					</div>
					<div class="editorial-copy about-hero__body">
						<p>
							Based in Miami with a presence in Asheville, North Carolina, Vero Beach, and Key Biscayne, we
							guide clients through space planning, design drawings, custom cabinetry, finishes, furnishings,
							window treatments, and turnkey installation.
						</p>
						<p>
							Inspired by texture, shape, light, and color, our multidisciplinary team creates every home
							around its client with close attention to detail and creative expression.
						</p>
						<a class="text-link" href="/work/">Explore our residential work</a>
					</div>
				</div>
			</div>
		</header>

		<section class="about-team-intro-section editorial-section">
			<div class="editorial-container about-team-intro">
				<p class="eyebrow">About the Team</p>
				<h2 class="section-heading">Experienced designers committed to every detail.</h2>
				<p class="about-team-intro__lead">
					Colors of Design brings together designers, architects, and collaborators who share a dedication to
					thoughtful interiors—from the first floor plan to the final installation.
				</p>
			</div>
		</section>

		{teamMembers.map((member) => (
			<TeamMember {...member} />
		))}

		<section class="about-perspective editorial-section">
			<div class="editorial-container about-perspective__inner">
				<p class="eyebrow">Our perspective</p>
				<h2 class="about-perspective__heading">Beautiful rooms.<br />A meaningful whole.</h2>
				<p class="about-perspective__copy">
					We look beyond individual pieces to how rooms connect, light moves, and objects give a space its
					character—always starting with the person who will live there, and the balance of beauty and everyday
					ease their home calls for.
				</p>
				<a class="text-link" href="/work-process/">Discover our process</a>
			</div>
		</section>

		<ConversionSection />
	</main>
</BaseLayout>

<style>
	.about-hero,
	.about-team-intro-section,
	.about-perspective {
		background-color: var(--color-bg);
	}

	.about-hero {
		padding: 2rem 0 clamp(3.5rem, 7vw, 6rem);
	}

	.about-hero__grid {
		padding-top: clamp(2rem, 5vw, 4rem);
		align-items: start;
		gap: clamp(3rem, 8vw, 8rem);
	}

	.about-hero__grid .editorial-copy {
		max-width: none;
	}

	.about-hero__lead h1 {
		font-family: var(--font-heading);
		font-weight: 400;
		font-size: clamp(2.8rem, 5.2vw, 4.8rem);
		line-height: 1.07;
		letter-spacing: -0.025em;
		margin: 0 0 1.5rem;
		text-wrap: balance;
	}

	.about-hero__body > p:first-child {
		margin-top: 0;
	}

	.about-team-intro {
		max-width: 44rem;
	}

	.about-team-intro .section-heading {
		margin-top: 1.25rem;
	}

	.about-team-intro__lead {
		margin-top: 1.25rem;
		color: var(--color-text-muted);
		line-height: 1.85;
		max-width: 36rem;
	}

	.about-perspective__inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		max-width: 40rem;
		margin-inline: auto;
	}

	.about-perspective__inner .eyebrow {
		margin-bottom: 1.25rem;
	}

	.about-perspective__heading {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 3vw, 3rem);
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.about-perspective__copy {
		margin-top: 1.25rem;
		color: var(--color-text-muted);
		line-height: 1.85;
	}

	.about-perspective__inner .text-link {
		margin-top: 1.75rem;
	}
</style>
