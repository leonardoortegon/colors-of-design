---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroOverlay from '../components/HeroOverlay.astro';
import SplitSection from '../components/SplitSection.astro';
import SelectedWork from '../components/SelectedWork.astro';
import ServicesSection from '../components/ServicesSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import JournalPreview from '../components/JournalPreview.astro';
import ConversionSection from '../components/ConversionSection.astro';
import { featuredServiceSlugs } from '../data/services';
import { getLocale, localizedPath } from '../i18n/locale';
import { pageCopy } from '../i18n/pages';
import { localizeProjects, localizeServices } from '../i18n/content';

const locale = getLocale(Astro.url.pathname);
const pages = pageCopy(locale);
const services = localizeServices(locale);
const featuredServices = featuredServiceSlugs
	.map((slug) => services.find((service) => service.slug === slug))
	.filter((service): service is NonNullable<typeof service> => service !== undefined);

const homepageProjectSlugs = ['solaris', 'park-grove', 'sunny-isles'];

const listedProjects = homepageProjectSlugs
	.map((slug) => localizeProjects(locale).find((project) => project.slug === slug))
	.filter((project): project is NonNullable<typeof project> => project !== undefined)
	.map((project) => ({
		name: project.name,
		location: project.location,
		scope: project.scope,
		concept: project.concept,
		imageSrc: project.imageSrc,
		imageAlt: project.imageAlt,
		imageWidth: project.imageWidth,
		imageHeight: project.imageHeight,
		href: localizedPath(locale, `/work/${project.slug}/`),
	}));
---

<BaseLayout title={pages.seo.homeTitle} description={pages.seo.homeDescription} transparentNav canonicalPath={localizedPath(locale, '/')}>
	<main id="main">
	<HeroOverlay
		eyebrow={pages.home.eyebrow}
		heading={pages.home.heading}
		description={pages.home.description}
		ctas={pages.home.ctas}
		trustItems={[...pages.home.trustItems]}
		imageSrc="/hero.jpg"
		imageAlt={pages.home.heroAlt}
	/>
	<div class="home-page__sections">
	<SplitSection
		heading={pages.home.splitHeading}
		copy={[pages.home.splitCopy]}
		linkLabel={pages.home.meetStudio}
		linkHref={localizedPath(locale, '/about-us/')}
	/>
	<SelectedWork
		heading={pages.home.selectedWork}
		introduction={pages.home.selectedIntro}
		projects={listedProjects}
		ctaLabel={pages.home.exploreAll}
		ctaHref={localizedPath(locale, '/work/')}
		centerHeader
	/>
	<ServicesSection
		heading={pages.home.howWeWork}
		introduction={pages.home.servicesIntro}
		services={featuredServices.map((service) => ({
			title: service.name,
			description: service.summary,
			imageSrc: service.imageSrc,
			imageAlt: service.imageAlt,
			href: `${localizedPath(locale, '/services/')}#${service.slug}`,
		}))}
		linkLabel={pages.home.exploreServices}
		linkHref={localizedPath(locale, '/services/')}
	/>
	<ProcessSection
		heading={pages.home.processHeading}
		steps={[...pages.home.processSteps]}
		linkLabel={pages.home.seeProcess}
		linkHref={localizedPath(locale, '/work-process/')}
	/>
	<SplitSection
		sectionId="studio"
		banded
		heading={pages.home.studioHeading}
		copy={[pages.home.studioCopy]}
		linkLabel={pages.home.meetTeam}
		linkStyle="text"
		linkHref={localizedPath(locale, '/about-us/')}
		imageSrc="/margaret.jpg"
		imageAlt={pages.home.studioAlt}
		imageWidth={1200}
		imageHeight={1500}
		imagePosition="left"
		imageMaxWidth="34rem"
	/>
	<JournalPreview />
	<ConversionSection />
	</div>
	</main>
</BaseLayout>

<style>
	.home-page__sections {
		--hero-max-width: 1400px;
	}
</style>
