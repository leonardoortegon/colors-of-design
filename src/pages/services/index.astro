---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServicesList from '../../components/ServicesList.astro';
import ConversionSection from '../../components/ConversionSection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { absoluteUrl, site } from '../../data/site';
import { getLocale, localizedPath } from '../../i18n/locale';
import { pageCopy } from '../../i18n/pages';
import { copy } from '../../i18n/ui';
import { localizeServices } from '../../i18n/content';

const locale = getLocale(Astro.url.pathname);
const pages = pageCopy(locale);
const t = copy(locale);
const services = localizeServices(locale);
const title = pages.services.title;
const description = pages.services.description;
const pageUrl = absoluteUrl(localizedPath(locale, '/services/'));

const jsonLd = [
	{
		'@type': 'CollectionPage',
		'@id': `${pageUrl}#page`,
		url: pageUrl,
		name: title,
		description,
		isPartOf: { '@id': `${site.url}/#website` },
		about: {
			'@type': 'Thing',
			name: pages.services.thingName,
		},
		mainEntity: {
			'@type': 'ItemList',
			name: pages.services.thingName,
			numberOfItems: services.length,
			itemListElement: services.map((service, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				url: `${pageUrl}#${service.slug}`,
				name: service.name,
				description: service.summary,
			})),
		},
	},
	{
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: pages.work.jsonHome,
				item: site.url,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: t.crumbs.services,
				item: pageUrl,
			},
		],
	},
	...services.map((service) => ({
		'@type': 'Service',
		'@id': `${pageUrl}#${service.slug}`,
		name: service.name,
		description: service.description,
		image: absoluteUrl(service.imageSrc),
		provider: { '@id': `${site.url}/#studio` },
		areaServed: ['Miami', 'South Florida', 'United States'],
	})),
];
---

<BaseLayout title={title} description={description} canonicalPath={localizedPath(locale, '/services/')} jsonLd={jsonLd}>
	<main class="page" id="main">
		<div class="services-page" data-nav-earth-top data-nav-surface="earth">
			<div class="services-page__crumbs">
				<Breadcrumbs items={[{ label: t.home, href: localizedPath(locale, '/') }, { label: t.crumbs.services }]} />
			</div>
			<ServicesList
				heading={pages.services.heading}
				headingLevel="h1"
				sectionId="offerings"
				centerHeaderOnDesktop
				gridLayout
				introduction={pages.services.introduction}
				services={services}
			/>
		</div>
		<ConversionSection />
	</main>
</BaseLayout>

<style>
	.services-page {
		background-color: var(--color-earth);
		--services-page-max-width: 1400px;
	}

	.services-page__crumbs {
		width: 100%;
		max-width: var(--services-page-max-width, 1400px);
		margin-inline: auto;
		padding: 2rem var(--site-gutter) 0;
	}

	.services-page :global(.services-list__inner) {
		max-width: var(--services-page-max-width, 1400px);
		padding-top: 1.5rem;
	}
</style>
