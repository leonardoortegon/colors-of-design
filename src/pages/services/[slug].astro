---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ConversionSection from '../../components/ConversionSection.astro';
import { services as allServices } from '../../data/services';
import { site, absoluteUrl } from '../../data/site';
import { getLocale, localizedPath } from '../../i18n/locale';
import { pageCopy } from '../../i18n/pages';
import { copy } from '../../i18n/ui';
import { localizeServices } from '../../i18n/content';

export function getStaticPaths() {
	return allServices.map((service) => ({
		params: { slug: service.slug },
	}));
}

const locale = getLocale(Astro.url.pathname);
const pages = pageCopy(locale);
const t = copy(locale);
const services = localizeServices(locale);
const service = services.find((item) => item.slug === Astro.params.slug);

if (!service) {
	throw new Error(`Unknown service: ${Astro.params.slug}`);
}
const url = localizedPath(locale, `/services/${service.slug}/`);
---

<BaseLayout
	title={pages.services.titleSuffix(service.name)}
	description={service.summary}
	image={service.imageSrc}
	canonicalPath={url}
	jsonLd={{
		'@type': 'Service',
		name: service.name,
		description: service.description,
		url: absoluteUrl(url),
		provider: { '@id': `${site.url}/#studio` },
		areaServed: ['Miami', 'South Florida', 'United States'],
	}}
>
	<main class="page" id="main">
		<section class="editorial-section service-hero" data-nav-earth-top>
			<div class="editorial-container">
				<Breadcrumbs
					items={[
						{ label: t.home, href: localizedPath(locale, '/') },
						{ label: t.crumbs.services, href: localizedPath(locale, '/services/') },
						{ label: service.name },
					]}
				/>
				<div class="editorial-grid service-hero__grid">
					<img
						class="editorial-image"
						src={service.imageSrc}
						alt={service.imageAlt}
						width={service.imageWidth}
						height={service.imageHeight}
					/>
					<div class="editorial-copy">
						<p class="eyebrow">{service.scope}</p>
						<h1>{service.name}</h1>
						<p class="service-hero__summary">{service.summary}</p>
						<p>{service.description}</p>
						<ul class="detail-list">
							{service.included.map((item) => (
								<li>{item}</li>
							))}
						</ul>
						<p>
							{pages.services.detailNote}
						</p>
						<a class="text-link" href={localizedPath(locale, '/work-process/')}>{pages.services.seeHow}</a>
					</div>
				</div>
			</div>
		</section>

		<section class="editorial-section service-related">
			<div class="editorial-container">
				<div class="service-related__layout">
					<div class="editorial-copy service-related__intro">
						<p class="eyebrow">{pages.services.inPractice}</p>
						<h2>{pages.services.moreThanRooms}</h2>
						<p>{pages.services.seeHowPlanning}</p>
						<a class="text-link" href={localizedPath(locale, '/work/')}>{pages.services.exploreProjects}</a>
					</div>
					<div class="service-related__services">
						<h2 class="service-related__heading">{pages.services.exploreServices}</h2>
						<ul class="service-related__list">
							{services
								.filter((item) => item.slug !== service.slug)
								.map((item) => (
									<li>
										<a class="service-related__link" href={localizedPath(locale, `/services/${item.slug}/`)}>
											{item.name}
										</a>
									</li>
								))}
						</ul>
					</div>
				</div>
			</div>
		</section>

		<ConversionSection />
	</main>
</BaseLayout>

<style>
	.service-hero {
		background-color: var(--color-earth);
	}

	.service-hero__grid {
		margin-top: clamp(2rem, 5vw, 4rem);
	}

	.service-hero__summary {
		color: var(--color-text-muted);
		margin-top: 1.25rem;
		line-height: 1.85;
	}

	.service-related {
		background-color: var(--color-bg);
	}

	.service-related__layout {
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(3rem, 6vw, 5rem);
	}

	.service-related__intro {
		max-width: 28rem;
	}

	.service-related__heading {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 3vw, 3rem);
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.service-related__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.875rem 2rem;
	}

	.service-related__link {
		display: inline-block;
		font-family: var(--font-heading);
		font-size: clamp(1.25rem, 1.6vw, 1.625rem);
		font-weight: 400;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--color-text);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.service-related__link:hover {
		color: var(--color-accent-hover);
	}

	@media (min-width: 901px) {
		.service-related__layout {
			grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
			gap: clamp(3rem, 8vw, 8rem);
			align-items: start;
		}

		.service-related__services {
			padding-top: 0.25rem;
		}

		.service-related__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			margin-top: clamp(1.75rem, 3vw, 2.5rem);
		}
	}
</style>
