---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ConversionSection from '../components/ConversionSection.astro';
import { getLocale, localizedPath } from '../i18n/locale';
import { pageCopy } from '../i18n/pages';
import { copy } from '../i18n/ui';

const locale = getLocale(Astro.url.pathname);
const pages = pageCopy(locale);
const t = copy(locale);
const steps = pages.process.steps;
---

<BaseLayout
	title={pages.process.title}
	description={pages.process.description}
	canonicalPath={localizedPath(locale, '/work-process/')}
>
	<main class="page" id="main">
		<section class="editorial-section process-hero">
			<div class="editorial-container">
				<Breadcrumbs items={[{ label: t.home, href: localizedPath(locale, '/') }, { label: t.crumbs.process }]} />
				<div class="editorial-grid process-hero__grid">
					<div class="editorial-copy">
						<p class="eyebrow">{pages.process.eyebrow}</p>
						<h1>{pages.process.h1}</h1>
						<p class="process-hero__lead">
							{pages.process.lead}
						</p>
						<p>
							{pages.process.p}
						</p>
						<a class="text-link" href={localizedPath(locale, '/services/')}>{pages.process.exploreServices}</a>
					</div>
					<img
						class="wide-image"
						src="/solaris/solaris-dinning-room-01.avif"
						alt={pages.process.imageAlt}
						width="2000"
						height="1334"
					/>
				</div>
			</div>
		</section>

		<section class="editorial-section editorial-container">
			<ol class="step-list">
				{steps.map(([title, copy], i) => (
					<li class="step-row">
						<p class="step-number">0{i + 1}</p>
						<h3>{title}</h3>
						<p>{copy}</p>
					</li>
				))}
			</ol>
		</section>

		<section class="editorial-section earth">
			<div class="editorial-container">
				<p class="eyebrow">{pages.process.faqEyebrow}</p>
				<h2 class="section-heading process-faq__heading">{pages.process.faqHeading}</h2>
				<div class="faq">
					<details>
						<summary>{pages.process.faqs[0].q}</summary>
						<p>{pages.process.faqs[0].a}</p>
					</details>
					<details>
						<summary>{pages.process.faqs[1].q}</summary>
						<p>
							{pages.process.faqs[1].a1}
							<a href={localizedPath(locale, '/home-decor-tips/5-ways-to-prepare-for-your-design-consultation/')}>
								{pages.process.faqs[1].linkLabel}
							</a>
							{pages.process.faqs[1].a2}
						</p>
					</details>
					<details>
						<summary>{pages.process.faqs[2].q}</summary>
						<p>
							{pages.process.faqs[2].a1}
							<a href={`${localizedPath(locale, '/services/')}#turn-key-services`}>{pages.process.faqs[2].linkLabel}</a>
							{pages.process.faqs[2].a2}
						</p>
					</details>
					<details>
						<summary>{pages.process.faqs[3].q}</summary>
						<p>{pages.process.faqs[3].a}</p>
					</details>
				</div>
			</div>
		</section>

		<ConversionSection />
	</main>
</BaseLayout>

<style>
	.process-hero {
		background-color: var(--color-bg);
	}

	.process-hero__grid {
		margin-top: clamp(2rem, 5vw, 4rem);
		align-items: center;
	}

	.process-hero__lead {
		color: var(--color-text-muted);
		margin-top: 1.25rem;
		line-height: 1.85;
	}

	.process-faq__heading {
		margin-top: 1rem;
	}
</style>
