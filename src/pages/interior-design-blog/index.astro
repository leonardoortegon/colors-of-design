---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JournalPreview from '../../components/JournalPreview.astro';
import ConversionSection from '../../components/ConversionSection.astro';
import { absoluteUrl, site } from '../../data/site';
import { getLocale, localizedPath } from '../../i18n/locale';
import { pageCopy } from '../../i18n/pages';
import { copy } from '../../i18n/ui';
import { localizeJournal } from '../../i18n/content';

const locale = getLocale(Astro.url.pathname);
const pages = pageCopy(locale);
const t = copy(locale);
const posts = localizeJournal(locale);
const title = pages.journal.title;
const description = pages.journal.description;
const pageUrl = absoluteUrl(localizedPath(locale, '/interior-design-blog/'));
---

<BaseLayout
	title={title}
	description={description}
	canonicalPath={localizedPath(locale, '/interior-design-blog/')}
	jsonLd={{
		'@type': 'Blog',
		name: pages.journal.jsonName,
		url: pageUrl,
		blogPost: posts.map((post) => ({
			'@type': 'BlogPosting',
			headline: post.title,
			url: absoluteUrl(post.url),
		})),
	}}
>
	<main class="page" id="main">
		<div class="journal-page">
			<div class="journal-page__crumbs">
				<Breadcrumbs items={[{ label: t.home, href: localizedPath(locale, '/') }, { label: t.crumbs.journal }]} />
			</div>
			<JournalPreview
				fullPage
				heading={pages.journal.heading}
				headingLevel="h1"
				eyebrow={pages.journal.eyebrow}
				centerHeaderOnDesktop
				introduction={pages.journal.introduction}
			/>
		</div>
		<ConversionSection />
	</main>
</BaseLayout>

<style>
	.journal-page {
		background-color: var(--color-bg);
		--journal-page-max-width: 1400px;
	}

	.journal-page__crumbs {
		width: 100%;
		max-width: var(--journal-page-max-width);
		margin-inline: auto;
		padding: 2rem var(--site-gutter) 0;
	}

	.journal-page :global(.journal-list__inner) {
		max-width: var(--journal-page-max-width);
		padding-top: 1.5rem;
	}
</style>
