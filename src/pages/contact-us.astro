---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import InquiryForm from '../components/InquiryForm.astro';
import InquiryFormIntro from '../components/InquiryFormIntro.astro';
import { site, absoluteUrl } from '../data/site';
import { getLocale, localizedPath } from '../i18n/locale';
import { pageCopy } from '../i18n/pages';
import { copy } from '../i18n/ui';

const locale = getLocale(Astro.url.pathname);
const pages = pageCopy(locale);
const t = copy(locale);
const contactPath = localizedPath(locale, '/contact-us/');
---

<BaseLayout
	title={pages.contact.title}
	description={pages.contact.description}
	canonicalPath={contactPath}
	jsonLd={{
		'@type': 'ContactPage',
		name: pages.contact.jsonName,
		url: absoluteUrl(contactPath),
		mainEntity: { '@id': `${site.url}/#studio` },
	}}
>
	<main class="page contact-page" id="main">
		<section class="contact-page__main">
			<div class="editorial-container">
				<Breadcrumbs items={[{ label: t.home, href: localizedPath(locale, '/') }, { label: t.crumbs.contact }]} />

				<div class="contact-page__split">
					<div class="contact-page__info editorial-copy">
						<p class="eyebrow">{t.crumbs.contact}</p>
						<h1>{pages.contact.h1}</h1>
						<p>
							{pages.contact.p1}
							{' '}
							<strong class="contact-page__closing">{pages.contact.p1Closing}</strong>
						</p>

						<dl class="contact-page__details">
							<div class="contact-page__detail">
								<dt>{pages.contact.email}</dt>
								<dd>
									<a href={`mailto:${site.email}`}>{site.email}</a>
								</dd>
							</div>
							<div class="contact-page__detail">
								<dt>{pages.contact.phone}</dt>
								<dd>
									<a href={site.phoneHref}>{site.phone}</a>
								</dd>
							</div>
							<div class="contact-page__detail">
								<dt>{pages.contact.studio}</dt>
								<dd>
									{site.streetAddress}
									<br />
									{site.locality}, {site.region} {site.postalCode}
								</dd>
							</div>
							<div class="contact-page__detail">
								<dt>{pages.contact.hours}</dt>
								<dd>{pages.contact.hoursValue}</dd>
							</div>
						</dl>

						<a class="text-link" href={localizedPath(locale, '/about-us/')}>{pages.contact.meetStudio}</a>
					</div>

					<div class="contact-page__form">
						<div class="contact-page__form-stack">
							<InquiryFormIntro showCopy={false} />
							<InquiryForm simple idPrefix="contact-" />
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>
