---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SelectedWork from '../../components/SelectedWork.astro';
import ConversionSection from '../../components/ConversionSection.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { absoluteUrl, site } from '../../data/site';
import { getLocale, localizedPath } from '../../i18n/locale';
import { pageCopy } from '../../i18n/pages';
import { copy } from '../../i18n/ui';
import { localizeProjects } from '../../i18n/content';

const locale = getLocale(Astro.url.pathname);
const pages = pageCopy(locale);
const t = copy(locale);
const projects = localizeProjects(locale);
const title = pages.work.title;
const description = pages.work.description;
const pageUrl = absoluteUrl(localizedPath(locale, '/work/'));

const listedProjects = projects.map((project) => ({
	name: project.name,
	location: project.location,
	scope: project.scope,
	concept: project.concept,
	imageSrc: project.imageSrc,
	imageAlt: project.imageAlt,
	imageWidth: project.imageWidth,
	imageHeight: project.imageHeight,
	href: localizedPath(locale, `/work/${project.slug}/`),
}));

const jsonLd = [
	{
		'@type': 'CollectionPage',
		'@id': `${pageUrl}#page`,
		url: pageUrl,
		name: title,
		description,
		isPartOf: { '@id': `${site.url}/#website` },
		about: {
			'@type': 'Thing',
			name: pages.work.thingName,
		},
		mainEntity: {
			'@type': 'ItemList',
			name: pages.work.listName,
			numberOfItems: projects.length,
			itemListElement: projects.map((project, index) => ({
				'@type': 'ListItem',
				position: index + 1,
				url: absoluteUrl(localizedPath(locale, `/work/${project.slug}/`)),
				name: pages.work.itemName(project.name),
			})),
		},
	},
	{
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: pages.work.jsonHome,
				item: absoluteUrl(localizedPath(locale, '/')),
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: t.crumbs.work,
				item: pageUrl,
			},
		],
	},
];
---

<BaseLayout title={title} description={description} canonicalPath={localizedPath(locale, '/work/')} jsonLd={jsonLd}>
	<main class="page" id="main">
		<div class="work-page">
			<div class="work-page__crumbs">
				<Breadcrumbs items={[{ label: t.home, href: localizedPath(locale, '/') }, { label: t.crumbs.work }]} />
			</div>
			<SelectedWork
				heading={pages.work.heading}
				headingLevel="h1"
				sectionId="projects"
				cardLayout="image-left"
				centerHeaderOnDesktop
				introduction={pages.work.introduction}
				projects={listedProjects}
			/>
		</div>
		<ConversionSection />
	</main>
</BaseLayout>

<style>
	.work-page {
		background-color: var(--color-bg);
		--work-page-max-width: 1400px;
	}

	.work-page__crumbs {
		width: 100%;
		max-width: var(--work-page-max-width);
		margin-inline: auto;
		padding: 2rem var(--site-gutter) 0;
	}

	.work-page :global(.work__inner) {
		max-width: var(--work-page-max-width);
		padding-top: 1.5rem;
	}

	@media (min-width: 901px) {
		.work-page :global(.work__header--center-desktop) {
			align-items: center;
			text-align: center;
			margin-bottom: clamp(4.5rem, 9vw, 6.5rem);
		}

		.work-page :global(.work__header--center-desktop .work__intro) {
			margin-inline: auto;
		}
	}
</style>
