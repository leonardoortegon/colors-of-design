---
export interface Service {
	title: string;
	description: string;
	imageSrc: string;
	imageAlt: string;
	href?: string;
}

interface Props {
	heading: string;
	introduction: string;
	services: Service[];
	linkLabel: string;
	linkHref?: string;
}

const { heading, introduction, services, linkLabel, linkHref = '/services' } = Astro.props;
---

<section class="services" id="services" aria-labelledby="services-heading">
	<div class="services__inner">
		<header class="services__header">
			<h2 id="services-heading" class="services__heading">{heading}</h2>
			<p class="services__intro">{introduction}</p>
		</header>

		<div class="services__grid">
			{services.map((service) => (
				<article class="services__card">
					<div class="services__card-media">
						<img
							class="services__card-image"
							src={service.imageSrc}
							alt={service.imageAlt}
							width="600"
							height="600"
							loading="lazy"
						/>
					</div>
					<div class="services__card-body">
						<h3 class="services__card-title">{service.title}</h3>
						<p class="services__card-description">{service.description}</p>
						<a class="services__card-link" href={service.href ?? '/services'}>
							Explore
							<svg
								class="services__card-link-arrow"
								width="10"
								height="10"
								viewBox="0 0 10 10"
								fill="none"
								xmlns="http://www.w3.org/2000/svg"
								aria-hidden="true"
							>
								<path
									d="M2 1l5 4-5 4"
									stroke="currentColor"
									stroke-width="1"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</a>
					</div>
				</article>
			))}
		</div>

		<div class="services__footer">
			<a class="services__link" href={linkHref}>{linkLabel}</a>
		</div>
	</div>
</section>

<style>
	.services {
		width: 100%;
		background-color: var(--color-bg);
	}

	.services__inner {
		width: 100%;
		max-width: var(--hero-max-width);
		margin-inline: auto;
		padding: clamp(4rem, 8vw, 7rem) var(--site-gutter);
	}

	.services__header {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-bottom: clamp(3rem, 6vw, 4.5rem);
		text-align: left;
	}

	.services__heading {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 3.5vw, 3rem);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.services__intro {
		font-family: var(--font-body);
		font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
		line-height: 1.75;
		color: var(--color-text-muted);
		max-width: 34rem;
	}

	@media (min-width: 901px) {
		.services__header {
			align-items: center;
			text-align: center;
		}

		.services__intro {
			margin-inline: auto;
		}
	}

	.services__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1.5rem, 3vw, 2.5rem);
	}

	.services__card {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.services__card-media {
		width: 100%;
		overflow: hidden;
	}

	.services__card-image {
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		object-position: center;
	}

	.services__card-body {
		display: flex;
		flex-direction: column;
		gap: 0.875rem;
		flex: 1;
		padding: clamp(1.25rem, 2.5vw, 1.75rem) 0;
	}

	.services__card-title {
		font-family: var(--font-heading);
		font-size: clamp(1.375rem, 2vw, 1.625rem);
		font-weight: 400;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--color-text);
	}

	.services__card-description {
		font-family: var(--font-body);
		font-size: clamp(0.875rem, 1vw, 0.9375rem);
		line-height: 1.7;
		color: var(--color-text-muted);
	}

	.services__card-link {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		width: fit-content;
		margin-top: auto;
		padding: 0.75rem 0 0;
		font-family: var(--font-body);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		transition: color 0.2s ease;
	}

	.services__card-link:hover {
		color: var(--color-text);
	}

	.services__card-link-arrow {
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	.services__card-link:hover .services__card-link-arrow {
		transform: translateX(0.2rem);
	}

	.services__footer {
		display: flex;
		justify-content: center;
		margin-top: clamp(3rem, 6vw, 4.5rem);
	}

	.services__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.875rem 2rem;
		font-family: var(--font-body);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text);
		background-color: transparent;
		border: 1px solid var(--color-accent);
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.services__link:hover {
		color: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
	}

	@media (max-width: 1024px) {
		.services__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.services__intro {
			max-width: none;
		}

		.services__grid {
			grid-template-columns: 1fr;
			gap: clamp(5.5rem, 12vw, 9rem);
		}
	}
</style>
