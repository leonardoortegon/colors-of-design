---
import InquiryForm from './InquiryForm.astro';
import InquiryFormIntro from './InquiryFormIntro.astro';
import { copy } from '../i18n/ui';
import type { Locale } from '../i18n/locale';

interface Props {
	locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = copy(locale);
---

<div class="inquiry-modal" data-inquiry-modal hidden aria-hidden="true">
	<div
		class="inquiry-modal__panel"
		role="dialog"
		aria-modal="true"
		aria-labelledby="inquiry-modal-heading"
		tabindex="-1"
		data-inquiry-panel
	>
		<button type="button" class="inquiry-modal__close" data-inquiry-close aria-label={t.close}>
			<svg class="inquiry-modal__close-icon" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
				<path d="M4 4 L14 14 M14 4 L4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
			</svg>
			<span>{t.close}</span>
		</button>

		<div class="inquiry-modal__inner">
			<InquiryFormIntro id="inquiry-modal-heading" locale={locale} />

			<InquiryForm simple idPrefix="modal-" locale={locale} source="modal" />
		</div>
	</div>
</div>

<style>
	.inquiry-modal {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: flex;
		align-items: stretch;
		justify-content: center;
		background-color: var(--color-earth);
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
	}

	.inquiry-modal[hidden] {
		display: none;
	}

	.inquiry-modal__panel {
		display: flex;
		flex-direction: column;
		width: 100%;
		min-height: 100%;
		outline: none;
	}

	.inquiry-modal__close {
		position: fixed;
		top: calc(0.875rem + env(safe-area-inset-top, 0px));
		right: var(--site-gutter);
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.375rem 0;
		font-family: var(--font-body);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		background: none;
		border: none;
		cursor: pointer;
		transition: color 0.2s ease;
	}

	.inquiry-modal__close-icon {
		display: block;
		flex-shrink: 0;
	}

	.inquiry-modal__close:hover {
		color: var(--color-text);
	}

	.inquiry-modal__inner {
		display: flex;
		flex-direction: column;
		gap: clamp(2.5rem, 5vw, 3.5rem);
		width: 100%;
		max-width: 30rem;
		margin: auto;
		padding: calc(4.75rem + 2rem) var(--site-gutter) clamp(3rem, 6vw, 4rem);
	}

</style>

<script is:inline>
	(function () {
		var modal = document.querySelector('[data-inquiry-modal]');
		if (!modal) return;

		function setPageInert(inert) {
			document.querySelectorAll('main, footer, header[data-nav]').forEach(function (element) {
				element.inert = inert;
			});
		}

		function closeNavMenu() {
			var nav = document.querySelector('[data-nav]');
			var toggle = nav && nav.querySelector('[data-nav-toggle]');
			if (nav && nav.classList.contains('is-open') && toggle) {
				nav.classList.remove('is-open');
				toggle.setAttribute('aria-expanded', 'false');
				toggle.setAttribute('aria-label', toggle.getAttribute('data-label-menu') || 'Menu');
				document.documentElement.classList.remove('nav-menu-open');
				document.querySelectorAll('main, footer').forEach(function (element) {
					element.inert = false;
				});
			}
		}

		function openModal() {
			closeNavMenu();
			modal.removeAttribute('hidden');
			modal.setAttribute('aria-hidden', 'false');
			document.documentElement.classList.add('inquiry-modal-open');
			setPageInert(true);
		}

		function closeModal() {
			modal.setAttribute('hidden', '');
			modal.setAttribute('aria-hidden', 'true');
			document.documentElement.classList.remove('inquiry-modal-open');
			setPageInert(false);
		}

		document.querySelectorAll('[data-inquiry-open]').forEach(function (trigger) {
			trigger.addEventListener('click', function (event) {
				event.preventDefault();
				openModal();
			});
		});

		modal.querySelectorAll('[data-inquiry-close]').forEach(function (button) {
			button.addEventListener('click', closeModal);
		});

		document.addEventListener('keydown', function (event) {
			if (event.key === 'Escape' && !modal.hasAttribute('hidden')) closeModal();
		});
	})();
</script>
