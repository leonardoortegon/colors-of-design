---
import type { Service } from '../data/services';
import { copy } from '../i18n/ui';
import { getLocale, localizedPath, type Locale } from '../i18n/locale';

interface Props {
	heading: string;
	introduction: string;
	services: Service[];
	headingLevel?: 'h1' | 'h2';
	sectionId?: string;
	alternateBackgrounds?: boolean;
	centerHeaderOnDesktop?: boolean;
	gridLayout?: boolean;
	locale?: Locale;
}

const {
	heading,
	introduction,
	services,
	headingLevel = 'h2',
	sectionId = 'services',
	alternateBackgrounds = false,
	centerHeaderOnDesktop = false,
	gridLayout = false,
	locale = getLocale(Astro.url.pathname),
} = Astro.props;

const HeadingTag = headingLevel;
const t = copy(locale);
---

<section
	class:list={[
		'services-list',
		alternateBackgrounds && 'services-list--banded',
		gridLayout && 'services-list--grid-page',
	]}
	id={sectionId}
	aria-labelledby="services-list-heading"
>
	<div class="services-list__inner">
		<header
			class:list={[
				'services-list__header',
				centerHeaderOnDesktop && 'services-list__header--center-desktop',
			]}
		>
			<HeadingTag id="services-list-heading" class="services-list__heading">{heading}</HeadingTag>
			<p class="services-list__intro">{introduction}</p>
		</header>

		<div class:list={['services-list__list', gridLayout && 'services-list__list--grid']}>
			{services.map((service, index) => {
				const cardClasses = [
					'services-list__card',
					gridLayout && 'services-list__card--grid',
					alternateBackgrounds && index % 2 === 0 && 'services-list__card--muted',
				];
				const cardContent = (
					<div class:list={['services-list__row', gridLayout && 'services-list__row--grid']}>
						<div class="services-list__media">
							<img
								src={service.imageSrc}
								alt={service.imageAlt}
								width={service.imageWidth}
								height={service.imageHeight}
								loading="lazy"
							/>
						</div>
						<div class="services-list__body">
							{headingLevel === 'h1' ? (
								<h2 class="services-list__name">{service.name}</h2>
							) : (
								<h3 class="services-list__name">{service.name}</h3>
							)}
							{!gridLayout && <p class="services-list__scope">{service.scope}</p>}
							<p class="services-list__copy">{gridLayout ? service.summary : service.description}</p>
							{!gridLayout && <p class="services-list__included">{service.included.join(' · ')}</p>}
							{gridLayout ? (
								<span class="services-list__action">{t.exploreWord}</span>
							) : (
								<a class="services-list__action" href={localizedPath(locale, `/services/${service.slug}/`)}>
									{t.exploreService(service.name)}
								</a>
							)}
						</div>
					</div>
				);

				return gridLayout ? (
					<a
						class:list={cardClasses}
						href={localizedPath(locale, `/services/${service.slug}/`)}
						id={service.slug}
						aria-label={t.exploreService(service.name)}
					>
						{cardContent}
					</a>
				) : (
					<article
						class:list={cardClasses}
						id={service.slug}
						data-nav-surface={alternateBackgrounds && index % 2 === 0 ? 'earth' : undefined}
					>
						{cardContent}
					</article>
				);
			})}
		</div>
	</div>
</section>

<style>
	.services-list {
		width: 100%;
		background-color: var(--color-bg);
		--services-gutter: var(--site-gutter);
	}

	.services-list__inner {
		width: 100%;
		max-width: var(--hero-max-width);
		margin-inline: auto;
		padding: clamp(4rem, 8vw, 7rem) var(--services-gutter);
	}

	.services-list__header {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-bottom: clamp(3rem, 6vw, 4.5rem);
		text-align: left;
	}

	.services-list__heading {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 3.5vw, 3rem);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.services-list__intro {
		font-family: var(--font-body);
		font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
		line-height: 1.75;
		color: var(--color-text-muted);
		max-width: 34rem;
	}

	.services-list__list {
		display: flex;
		flex-direction: column;
		gap: clamp(4rem, 8vw, 7rem);
	}

	.services-list--banded .services-list__list {
		gap: 0;
	}

	.services-list--banded .services-list__card {
		position: relative;
		isolation: isolate;
		margin-inline: calc(-1 * var(--services-gutter));
		padding: clamp(4rem, 8vw, 7rem) var(--services-gutter);
	}

	.services-list--banded .services-list__card--muted::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: 0;
		left: 50%;
		width: 100vw;
		transform: translateX(-50%);
		background-color: var(--color-earth);
	}

	.services-list__row {
		display: grid;
		grid-template-columns: minmax(0, 13fr) minmax(0, 7fr);
		align-items: center;
		gap: clamp(2rem, 3.5vw, 3.25rem);
	}

	.services-list__body {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		order: 2;
		align-self: center;
	}

	.services-list__media {
		order: 1;
		width: 100%;
		overflow: hidden;
	}

	.services-list__media img {
		display: block;
		width: 100%;
		aspect-ratio: 1 / 1;
		object-fit: cover;
		object-position: center;
	}

	.services-list__name {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 2.4vw, 2rem);
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1.2;
		color: var(--color-text);
	}

	.services-list__scope,
	.services-list__included {
		font-family: var(--font-body);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		line-height: 1.6;
	}

	.services-list__copy {
		font-family: var(--font-body);
		font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
		line-height: 1.75;
		color: var(--color-text-muted);
	}

	.services-list__action {
		display: inline-flex;
		width: fit-content;
		margin-top: 0.5rem;
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		border-bottom: 1px solid rgba(26, 26, 26, 0.35);
	}

	.services-list__action:hover {
		border-color: var(--color-text);
	}

	@media (min-width: 901px) {
		.services-list__header--center-desktop {
			align-items: center;
			text-align: center;
		}

		.services-list__header--center-desktop .services-list__intro {
			margin-inline: auto;
		}
	}

	.services-list__list--grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 2.5rem);
	}

	.services-list--grid-page {
		background-color: var(--color-earth);
	}

	a.services-list__card--grid {
		display: block;
		text-decoration: none;
		color: inherit;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}

	a.services-list__card--grid:hover {
		box-shadow: 0 12px 32px rgba(26, 26, 26, 0.08);
	}

	a.services-list__card--grid:hover .services-list__action {
		border-color: var(--color-text);
	}

	.services-list__card--grid {
		height: 100%;
		padding: clamp(1.25rem, 2.5vw, 1.75rem);
		background-color: var(--color-bg);
	}

	.services-list__row--grid {
		display: flex;
		flex-direction: column;
		height: 100%;
		gap: 0;
	}

	.services-list__row--grid .services-list__media {
		order: 0;
		width: 100%;
	}

	.services-list__row--grid .services-list__body {
		order: 0;
		flex: 1;
		padding-top: clamp(1.25rem, 2.5vw, 1.5rem);
	}

	.services-list__row--grid .services-list__action {
		margin-top: auto;
		padding-bottom: 0.125rem;
	}

	@media (max-width: 1024px) {
		.services-list__list--grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 900px) {
		.services-list__intro {
			max-width: none;
		}

		.services-list__row {
			grid-template-columns: 1fr;
		}

		.services-list__body {
			order: 0;
		}

		.services-list__media {
			order: -1;
		}

		.services-list__list--grid {
			grid-template-columns: 1fr;
		}
	}
</style>
