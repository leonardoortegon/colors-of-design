---
import InquiryFormIntro from './InquiryFormIntro.astro';
import { site } from '../data/site';
import { copy } from '../i18n/ui';
import { getLocale, type Locale } from '../i18n/locale';

interface Props {
	submitLabel?: string;
	privacyNote?: string;
	locale?: Locale;
}

const { locale = getLocale(Astro.url.pathname), submitLabel, privacyNote } = Astro.props;
const t = copy(locale);
const resolvedSubmit = submitLabel ?? t.submitLabel;
const resolvedPrivacy = privacyNote ?? t.conversionPrivacy;
---

<section class="conversion" id="inquiry" aria-labelledby="conversion-heading" data-nav-surface="earth">
	<div class="conversion__inner">
		<div class="conversion__stack">
			<InquiryFormIntro id="conversion-heading" locale={locale} />

			<div class="conversion__form-panel">
				<form class="conversion__form" data-conversion-form data-recipient={site.email} data-mail-hello={t.mailHello} data-mail-name={t.mailName} data-mail-phone={t.mailPhone} data-subject-from={t.mailSubjectFrom('__NAME__')}>
					<div class="conversion__field">
						<label class="conversion__label" for="conversion-name">{t.name}</label>
						<input
							class="conversion__input"
							type="text"
							id="conversion-name"
							name="name"
							autocomplete="name"
							required
							maxlength="100"
						/>
					</div>

					<div class="conversion__field">
						<label class="conversion__label" for="conversion-phone">{t.phone}</label>
						<input
							class="conversion__input"
							type="tel"
							id="conversion-phone"
							name="phone"
							autocomplete="tel"
							required
							maxlength="40"
						/>
					</div>

					<div class="conversion__field">
						<label class="conversion__label" for="conversion-message">{t.message}</label>
						<textarea
							class="conversion__textarea"
							id="conversion-message"
							name="message"
							rows="4"
							required
							maxlength="1800"
						></textarea>
					</div>

					<button type="submit" class="conversion__submit">{resolvedSubmit}</button>
				</form>

				<p class="conversion__privacy">{resolvedPrivacy}</p>
			</div>
		</div>
	</div>
</section>

<style>
	.conversion {
		width: 100%;
		background-color: var(--color-earth);
	}

	.conversion__inner {
		width: 100%;
		max-width: var(--hero-max-width);
		margin-inline: auto;
		padding: clamp(4rem, 8vw, 7rem) var(--site-gutter);
	}

	.conversion__stack {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: clamp(2.5rem, 5vw, 3.5rem);
		width: 100%;
		max-width: 30rem;
		margin-inline: auto;
	}

	.conversion__form-panel {
		width: 100%;
	}

	.conversion__form {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.conversion__field {
		display: flex;
		flex-direction: column;
		gap: 0.625rem;
	}

	.conversion__label {
		font-family: var(--font-body);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.conversion__input,
	.conversion__textarea {
		width: 100%;
		padding: 0.625rem 0;
		font-family: var(--font-body);
		font-size: 1rem;
		line-height: 1.5;
		color: var(--color-text);
		background-color: transparent;
		border: none;
		border-bottom: 1px solid rgba(26, 26, 26, 0.16);
		border-radius: 0;
		transition: border-color 0.2s ease;
	}

	.conversion__input:focus,
	.conversion__textarea:focus {
		outline: none;
		border-bottom-color: var(--color-text);
	}

	.conversion__textarea {
		resize: vertical;
		min-height: 6rem;
	}

	.conversion__submit {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		margin-top: 0.5rem;
		padding: 0.875rem 2rem;
		font-family: var(--font-body);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #ffffff;
		background-color: var(--color-text);
		border: 1px solid var(--color-text);
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.conversion__submit:hover {
		color: #ffffff;
		background-color: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
	}

	.conversion__privacy {
		margin-top: 1.25rem;
		font-family: var(--font-body);
		font-size: 0.75rem;
		line-height: 1.6;
		color: var(--color-text-muted);
		opacity: 0.85;
	}
</style>

<script>
	document.querySelectorAll<HTMLFormElement>('[data-conversion-form]').forEach((form) => {
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;

			const data = new FormData(form);
			const value = (key: string) => String(data.get(key) || '').trim();
			const subjectTemplate = form.dataset.subjectFrom || 'Project inquiry from __NAME__';
			const subject = subjectTemplate.replace('__NAME__', value('name'));
			const hello = form.dataset.mailHello || 'Hello Colors of Design,';
			const body = `${hello}\n\n${value('message')}\n\n${form.dataset.mailName || 'Name'}: ${value('name')}\n${form.dataset.mailPhone || 'Phone'}: ${value('phone')}`;
			window.location.href = `mailto:${form.dataset.recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
		});
	});
</script>
