---
import type { AwardRecognition } from '../data/awards';

interface Props extends AwardRecognition {}

const {
	eyebrow,
	heading,
	image,
	imageCaption,
	logos,
	logosPosition = 'media',
	lead,
	paragraphs,
	badges,
} = Astro.props;

const hasBadges = badges && badges.length > 0;

const logosInCopy = logosPosition === 'copy' && logos && logos.length > 0;
const logosInMedia = logosPosition === 'media' && logos && logos.length > 0;
---

<section class="award-entry editorial-section">
	<div class="editorial-container">
		<div class="editorial-grid">
			<figure class="award-entry__media">
				{
					image && (
						<img
							class="award-entry__image"
							src={image.src}
							alt={image.alt}
							width={image.width}
							height={image.height}
							loading="lazy"
						/>
					)
				}
				{
					hasBadges && !image && (
						<div class="award-entry__badges">
							{badges.map((badge) => (
								<img class="award-entry__badge" src={badge.src} alt={badge.alt} loading="lazy" />
							))}
						</div>
					)
				}
				{
					logosInMedia && (
						<div class="award-entry__logos">
							{logos.map((logo) => (
								<img src={logo.src} alt={logo.alt} loading="lazy" />
							))}
						</div>
					)
				}
				{imageCaption && <figcaption class="caption">{imageCaption}</figcaption>}
			</figure>
			<div class="editorial-copy">
				{
					logosInCopy && (
						<div class="award-entry__logos award-entry__logos--copy">
							{logos.map((logo) => (
								<img src={logo.src} alt={logo.alt} loading="lazy" />
							))}
						</div>
					)
				}
				<p class="eyebrow">{eyebrow}</p>
				<h2 set:html={heading.replace('. ', '.<br />')} />
				{lead && <p class="award-entry__lead">{lead}</p>}
				{paragraphs.map((paragraph) => (
					<p>{paragraph}</p>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.award-entry {
		background-color: var(--color-bg);
	}

	.award-entry + .award-entry {
		padding-top: 0;
	}

	.award-entry__media {
		max-width: min(100%, 480px);
		margin: 0;
	}

	.award-entry__image {
		display: block;
		width: 100%;
		height: auto;
		max-height: 40rem;
		object-fit: contain;
	}

	.award-entry__badges {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(0.75rem, 2vw, 1.25rem);
		width: 100%;
	}

	.award-entry__badge {
		display: block;
		width: 100%;
		max-width: 11rem;
		height: auto;
		justify-self: center;
	}

	.award-entry__media:has(.award-entry__badges .award-entry__badge:only-child) {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 100%;
	}

	.award-entry__badges:has(.award-entry__badge:only-child) {
		display: flex;
		justify-content: center;
		align-items: center;
		width: 100%;
	}

	.award-entry__badges:has(.award-entry__badge:only-child) .award-entry__badge {
		max-width: min(100%, clamp(16rem, 32vw, 28rem));
	}

	.award-entry__logos {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: clamp(1rem, 2vw, 1.5rem);
		margin-top: 1.25rem;
	}

	.award-entry__logos img {
		display: block;
		width: auto;
		max-width: min(100%, 9rem);
		height: auto;
		max-height: 2.75rem;
	}

	.award-entry__logos--copy {
		justify-content: flex-end;
		margin-top: 0;
		margin-bottom: 1.25rem;
	}

	.award-entry__lead {
		font-size: clamp(1rem, 1.2vw, 1.0625rem);
		line-height: 1.85;
		color: var(--color-text-muted);
		font-style: italic;
		margin-top: 1.25rem;
	}

	@media (max-width: 720px) {
		.award-entry .editorial-copy {
			order: 1;
		}

		.award-entry .award-entry__media {
			order: 2;
		}
	}

	@media (min-width: 721px) {
		.award-entry .editorial-grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}

		.award-entry__media {
			max-width: clamp(400px, 42vw, 560px);
			justify-self: start;
		}

		.award-entry__badges {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
