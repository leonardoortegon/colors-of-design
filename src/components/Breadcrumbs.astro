---
interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
	<ol class="crumbs__list">
		{items.map((item, index) => (
			<li class="crumbs__item">
				{item.href ? (
					<a class="crumbs__link" href={item.href}>{item.label}</a>
				) : (
					<span class="crumbs__current" aria-current="page">{item.label}</span>
				)}
				{index < items.length - 1 && (
					<span class="crumbs__sep" aria-hidden="true">/</span>
				)}
			</li>
		))}
	</ol>
</nav>

<style>
	.crumbs {
		margin-bottom: 1.25rem;
	}

	.crumbs__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.375rem 0.5rem;
		list-style: none;
	}

	.crumbs__item {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.crumbs__link,
	.crumbs__current,
	.crumbs__sep {
		font-family: var(--font-body);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.crumbs__link {
		color: var(--color-text-muted);
		transition: color 0.2s ease;
	}

	.crumbs__link:hover {
		color: var(--color-text);
	}

	.crumbs__current {
		color: var(--color-text);
	}

	.crumbs__sep {
		color: rgba(26, 26, 26, 0.35);
	}
</style>
