---
import { site } from '../data/site';
import { copy } from '../i18n/ui';
import { localizedPath, switchLocalePath, type Locale } from '../i18n/locale';
import { pageCopy } from '../i18n/pages';

interface NavLink {
	label: string;
	href: string;
}

interface Props {
	companyName?: string;
	phone?: string;
	phoneHref?: string;
	ctaLabel?: string;
	links?: NavLink[];
	currentPath?: string;
	transparentOverHero?: boolean;
	hideOnScroll?: boolean;
	locale?: Locale;
}

const {
	companyName = 'Colors of Design Group',
	phone = '(786) 675-1484',
	phoneHref = 'tel:+17866751484',
	currentPath = '/',
	transparentOverHero = false,
	hideOnScroll = false,
	locale = 'en',
	ctaLabel,
	links,
} = Astro.props;

const t = copy(locale);
const pages = pageCopy(locale);
const resolvedCtaLabel = ctaLabel ?? t.navCta;
const resolvedLinks = links ?? pages.navLinks;
const homeHref = localizedPath(locale, '/');
const isNotFound = /404/.test(currentPath);
const activeLanguageCode = locale;
const currentLanguageLabel = locale === 'es' ? 'Español' : 'English';
const languageOptions = [
	{ code: 'en' as const, label: 'English', href: isNotFound ? localizedPath('en', '/') : switchLocalePath(currentPath, 'en') },
	{ code: 'es' as const, label: 'Español', href: isNotFound ? localizedPath('es', '/') : switchLocalePath(currentPath, 'es') },
];
---

<header
	class:list={['nav', transparentOverHero && 'nav--over-hero']}
	data-nav
	data-nav-transparent={transparentOverHero ? 'true' : undefined}
	data-nav-scroll-hide={hideOnScroll ? 'true' : undefined}
>
	<div class="nav__inner">
		<a href={homeHref} class="nav__brand" aria-label={`${companyName}, ${t.home.toLowerCase()}`}>
			<img class="nav__logo" src="/logo.svg" alt="Colors of Design" width="28" height="28" decoding="async" />
			<span class="nav__brand-text">{companyName}</span>
		</a>

		<div class="nav__menu" id="site-nav-menu" data-nav-menu>
			<div class="nav__menu-center">
				<nav class="nav__links" aria-label={t.primaryNav}>
					{resolvedLinks.map((link) => {
					const isCurrent =
						currentPath.replace(/\/$/, '') === link.href.replace(/\/$/, '') || currentPath.startsWith(link.href.replace(/\/$/, '') + '/');
						return (
							<a
								href={link.href}
								class="nav__link"
								aria-current={isCurrent ? 'page' : undefined}
							>
								{link.label}
							</a>
						);
					})}
					<div class="nav__language" data-nav-language>
						<button
							type="button"
							class="nav__language-trigger"
							data-nav-language-trigger
							aria-expanded="false"
							aria-haspopup="listbox"
							aria-label={`${t.languagePrefix}: ${currentLanguageLabel}`}
						>
							{currentLanguageLabel}
							<svg class="nav__language-icon" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
								<path
									d="M1 1 L5 5 L9 1"
									fill="none"
									stroke="currentColor"
									stroke-width="1.25"
									stroke-linecap="round"></path>
							</svg>
						</button>
						<ul class="nav__language-dropdown" role="listbox" aria-label={t.selectLanguage}>
							{
								languageOptions.map((language) => (
									<li class="nav__language-item" role="presentation">
										<a
											class:list={[
												'nav__language-option',
												language.code === activeLanguageCode && 'is-active',
											]}
											href={language.href}
											role="option"
											aria-selected={language.code === activeLanguageCode ? 'true' : 'false'}
											hreflang={language.code}
											lang={language.code}
										>
											{language.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</nav>

				<button type="button" class="nav__cta nav__cta--menu" data-inquiry-open>
					{t.startProject}
				</button>
			</div>
		</div>

		<div class="nav__actions">
			<a href={phoneHref} class="nav__phone">{phone}</a>
			<button type="button" class="nav__cta" data-inquiry-open>{resolvedCtaLabel}</button>
		</div>

		<button
			type="button"
			class="nav__toggle"
			aria-expanded="false"
			aria-controls="site-nav-menu"
			aria-label={t.menu}
			data-nav-toggle
			data-label-menu={t.menu}
			data-label-close={t.closeMenu}
		>
			<span class="nav__toggle-icon" aria-hidden="true"></span>
		</button>
	</div>
</header>

<style>
	.nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		background-color: rgba(255, 255, 255, 0.72);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		backdrop-filter: blur(20px) saturate(160%);
		transform: translateY(0);
		transition:
			background-color 0.25s ease,
			-webkit-backdrop-filter 0.25s ease,
			backdrop-filter 0.25s ease,
			transform 0.3s ease,
			color 0.25s ease,
			border-color 0.25s ease;
	}

	.nav--hidden {
		transform: translateY(-100%);
	}

	.nav--earth {
		background-color: rgba(250, 248, 243, 0.78);
		-webkit-backdrop-filter: blur(20px) saturate(160%);
		backdrop-filter: blur(20px) saturate(160%);
	}

	.nav--over-hero {
		background-color: transparent;
		backdrop-filter: none;
	}

	.nav--over-hero .nav__brand,
	.nav--over-hero .nav__link,
	.nav--over-hero .nav__toggle,
	.nav--over-hero .nav__language-trigger {
		color: #ffffff;
	}

	.nav--over-hero .nav__phone {
		color: rgba(255, 255, 255, 0.78);
	}

	.nav--over-hero .nav__link:hover,
	.nav--over-hero .nav__link[aria-current='page'],
	.nav--over-hero .nav__language-trigger:hover,
	.nav--over-hero .nav__language.is-open .nav__language-trigger {
		color: rgba(255, 255, 255, 0.88);
	}

	.nav--over-hero .nav__phone:hover {
		color: #ffffff;
	}

	.nav--over-hero .nav__cta {
		color: #ffffff;
		background-color: transparent;
		border-color: #ffffff;
	}

	.nav--over-hero .nav__cta:hover {
		color: #ffffff;
		background-color: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
	}

	.nav__inner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 1.5rem;
		width: 100%;
		max-width: var(--hero-max-width);
		margin-inline: auto;
		padding: 0.875rem var(--site-gutter);
	}

	.nav__brand {
		display: inline-flex;
		flex-flow: row nowrap;
		align-items: center;
		gap: 0.4375rem;
		justify-self: start;
		width: fit-content;
		max-width: 100%;
		color: var(--color-text);
		text-decoration: none;
	}

	.nav__logo {
		display: block;
		width: clamp(1.25rem, 1.75vw, 1.5rem);
		height: clamp(1.25rem, 1.75vw, 1.5rem);
		max-width: none;
		flex: 0 0 auto;
	}

	.nav__brand-text {
		flex: 0 1 auto;
		font-family: var(--font-body);
		font-size: clamp(0.8125rem, 1.15vw, 0.875rem);
		font-weight: 350;
		line-height: 1;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.nav__toggle {
		display: none;
		align-items: center;
		justify-content: center;
		padding: 0.375rem;
		color: var(--color-text);
	}

	.nav__toggle-icon {
		position: relative;
		width: 1.125rem;
		height: 0.75rem;
	}

	.nav__toggle-icon::before,
	.nav__toggle-icon::after {
		content: '';
		position: absolute;
		left: 0;
		width: 100%;
		height: 1px;
		background-color: currentColor;
		transition: transform 0.2s ease, top 0.2s ease;
	}

	.nav__toggle-icon::before {
		top: 0.125rem;
	}

	.nav__toggle-icon::after {
		top: 0.625rem;
	}

	.nav.is-open .nav__toggle-icon::before {
		top: 0.375rem;
		transform: rotate(45deg);
	}

	.nav.is-open .nav__toggle-icon::after {
		top: 0.375rem;
		transform: rotate(-45deg);
	}

	.nav__menu {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(1rem, 2vw, 1.625rem);
		min-width: 0;
	}

	.nav__menu-center {
		display: contents;
	}

	.nav__menu-footer {
		display: none;
	}

	.nav__links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.625rem clamp(1.5rem, 3vw, 2.5rem);
	}

	.nav__link,
	.nav__language-trigger,
	.nav__language-option {
		font-family: var(--font-body);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text);
		transition: color 0.2s ease;
		white-space: nowrap;
	}

	.nav__link:hover,
	.nav__link[aria-current='page'],
	.nav__language-trigger:hover,
	.nav__language.is-open .nav__language-trigger,
	.nav__language-option.is-active {
		color: var(--color-accent-hover);
	}

	.nav__language {
		position: relative;
		display: flex;
		align-items: center;
		flex-shrink: 0;
	}

	.nav__language-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0;
		background: none;
		border: none;
		cursor: pointer;
	}

	.nav__language-icon {
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	.nav__language.is-open .nav__language-icon {
		transform: rotate(180deg);
	}

	.nav__language-dropdown {
		position: absolute;
		top: calc(100% + 0.625rem);
		left: 50%;
		transform: translateX(-50%);
		min-width: 8.5rem;
		margin: 0;
		padding: 0.375rem 0;
		list-style: none;
		background-color: #ffffff;
		border: 1px solid rgba(26, 26, 26, 0.12);
		box-shadow: 0 8px 24px rgba(26, 26, 26, 0.08);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.2s ease, visibility 0.2s ease;
	}

	.nav__language.is-open .nav__language-dropdown {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}

	.nav__language-item {
		margin: 0;
	}

	.nav__language-option {
		display: block;
		width: 100%;
		padding: 0.625rem 1rem;
		text-align: left;
		text-decoration: none;
		color: inherit;
		cursor: pointer;
	}

	.nav__actions {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: clamp(0.75rem, 2vw, 1.25rem);
		min-width: 0;
	}

	.nav__phone {
		font-family: var(--font-body);
		font-size: 0.875rem;
		font-weight: 400;
		letter-spacing: 0.02em;
		color: var(--color-text-muted);
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.nav__phone:hover {
		color: var(--color-text);
	}

	.nav__phone--menu {
		display: none;
	}

	.nav__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		padding: 0.625rem 1.125rem;
		font: inherit;
		appearance: none;
		font-family: var(--font-body);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text);
		background-color: transparent;
		border: 1px solid var(--color-text);
		transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
		white-space: nowrap;
	}

	.nav__cta:hover {
		color: #ffffff;
		background-color: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
	}

	.nav__cta--menu {
		display: none;
	}

	@media (max-width: 1100px) {
		.nav__inner {
			grid-template-columns: minmax(0, 1fr) auto auto;
		}

		.nav.is-open {
			background-color: #ffffff;
		}

		.nav.is-open.nav--earth {
			background-color: #ffffff;
		}

		.nav.is-open .nav__inner {
			position: relative;
			z-index: 101;
		}

		.nav__toggle {
			display: inline-flex;
			justify-self: end;
			position: relative;
			z-index: 101;
		}

		.nav__brand,
		.nav__actions {
			position: relative;
			z-index: 101;
		}

		.nav__menu {
			display: flex;
			position: fixed;
			inset: 0;
			z-index: 100;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 0;
			min-height: 100svh;
			padding: calc(4.75rem + 1.5rem) var(--site-gutter)
				calc(1.5rem + env(safe-area-inset-bottom, 0px));
			background-color: #ffffff;
			overflow-y: auto;
			opacity: 0;
			visibility: hidden;
			pointer-events: none;
			transition: opacity 0.25s ease, visibility 0.25s ease;
		}

		.nav.is-open .nav__menu {
			opacity: 1;
			visibility: visible;
			pointer-events: auto;
		}

		.nav__menu-center {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 2rem;
			width: 100%;
		}

		.nav__links {
			flex-direction: column;
			align-items: center;
			gap: 1.5rem;
		}

		.nav.is-open .nav__link,
		.nav.is-open .nav__language-trigger,
		.nav.is-open .nav__language-option {
			font-size: 0.9375rem;
			letter-spacing: 0.12em;
		}

		.nav__language {
			flex-direction: column;
			align-items: center;
			justify-content: center;
		}

		.nav__language-dropdown {
			position: static;
			transform: none;
			min-width: 0;
			width: auto;
			margin-top: 0.5rem;
			box-shadow: none;
			border: none;
			text-align: center;
		}

		.nav__language-option {
			text-align: center;
		}

		.nav__phone {
			display: inline-flex;
		}

		.nav__cta {
			display: none;
		}

		.nav__cta--menu {
			display: inline-flex;
			width: auto;
			min-width: 14rem;
			padding: 0.875rem 1.5rem;
			font-size: 0.9375rem;
			letter-spacing: 0.12em;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nav {
			transition: background-color 0.25s ease;
		}

		.nav--hidden {
			transform: none;
		}

		.nav__menu {
			transition: none;
		}
	}

	@media (max-width: 640px) {
		.nav__actions {
			gap: 0.5rem;
		}

		.nav__brand-text {
			font-size: 0.75rem;
			letter-spacing: 0.015em;
		}
	}
</style>

<script is:inline>
	(function () {
		function initNavSurface(nav) {
			var earthTopMarker = document.querySelector('[data-nav-earth-top]');
			var earthRegions = Array.prototype.slice.call(
				document.querySelectorAll('[data-nav-surface="earth"]')
			);

			if (!earthTopMarker && earthRegions.length === 0) return;

			var topThreshold = 8;

			function isOverEarthRegion() {
				var probeY = Math.max(1, nav.getBoundingClientRect().bottom - 1);

				for (var i = 0; i < earthRegions.length; i++) {
					var rect = earthRegions[i].getBoundingClientRect();
					if (rect.top <= probeY && rect.bottom > 0) {
						return true;
					}
				}

				return false;
			}

			function updateNavSurface() {
				var scrollY = window.scrollY || window.pageYOffset;
				var useEarth =
					(scrollY <= topThreshold && earthTopMarker) || isOverEarthRegion();

				nav.classList.toggle('nav--earth', useEarth);
			}

			updateNavSurface();
			window.addEventListener('scroll', updateNavSurface, { passive: true });
			window.addEventListener('resize', updateNavSurface);
		}

		function setNavOpen(nav, toggle, isOpen) {
			nav.classList.toggle('is-open', isOpen);
			toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
			toggle.setAttribute('aria-label', isOpen ? (toggle.getAttribute('data-label-close') || 'Close menu') : (toggle.getAttribute('data-label-menu') || 'Menu'));
			document.documentElement.classList.toggle('nav-menu-open', isOpen);
			document.querySelectorAll('main, footer').forEach(function (element) { element.inert = isOpen; });
			var languageRoot = nav.querySelector('[data-nav-language]');
			var languageTrigger = languageRoot && languageRoot.querySelector('[data-nav-language-trigger]');
			if (languageRoot) languageRoot.classList.remove('is-open');
			if (languageTrigger) languageTrigger.setAttribute('aria-expanded', 'false');
			if (nav.getAttribute('data-nav-transparent') === 'true') {
				var scrollY = window.scrollY || window.pageYOffset;
				nav.classList.toggle('nav--over-hero', scrollY <= 8 && !isOpen);
			}
		}

		function initNavHeroTransparency(nav) {
			if (nav.getAttribute('data-nav-transparent') !== 'true') return;

			var topThreshold = 8;

			function updateNavHeroState() {
				var scrollY = window.scrollY || window.pageYOffset;
				var overHero = scrollY <= topThreshold && !nav.classList.contains('is-open');
				nav.classList.toggle('nav--over-hero', overHero);
			}

			updateNavHeroState();
			window.addEventListener('scroll', updateNavHeroState, { passive: true });
			window.addEventListener('resize', updateNavHeroState);
		}

		function initLanguage(nav) {
			var languageRoot = nav.querySelector('[data-nav-language]');
			if (!languageRoot) return;

			var trigger = languageRoot.querySelector('[data-nav-language-trigger]');
			if (!trigger) return;

			function setLanguageOpen(isOpen) {
				languageRoot.classList.toggle('is-open', isOpen);
				trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
			}

			trigger.addEventListener('click', function (event) {
				event.stopPropagation();
				setLanguageOpen(!languageRoot.classList.contains('is-open'));
			});

			document.addEventListener('click', function (event) {
				if (!languageRoot.contains(event.target)) {
					setLanguageOpen(false);
				}
			});

			document.addEventListener('keydown', function (event) {
				if (event.key === 'Escape' && languageRoot.classList.contains('is-open')) {
					setLanguageOpen(false);
					trigger.focus();
				}
			});
		}

		function initNavScrollHide(nav) {
			if (nav.getAttribute('data-nav-scroll-hide') !== 'true') return;
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

			var lastScrollY = window.scrollY || window.pageYOffset;
			var minScroll = 72;
			var ticking = false;

			function updateNavVisibility() {
				if (nav.classList.contains('is-open')) {
					nav.classList.remove('nav--hidden');
					lastScrollY = window.scrollY || window.pageYOffset;
					ticking = false;
					return;
				}

				var scrollY = window.scrollY || window.pageYOffset;
				var delta = scrollY - lastScrollY;

				if (scrollY <= minScroll) {
					nav.classList.remove('nav--hidden');
				} else if (delta > 4) {
					nav.classList.add('nav--hidden');
				} else if (delta < -4) {
					nav.classList.remove('nav--hidden');
				}

				lastScrollY = scrollY;
				ticking = false;
			}

			window.addEventListener(
				'scroll',
				function () {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(updateNavVisibility);
					}
				},
				{ passive: true }
			);
		}

		function initNav(nav) {
			var toggle = nav.querySelector('[data-nav-toggle]');
			var menu = nav.querySelector('[data-nav-menu]');
			if (!toggle || !menu) return;

			initNavSurface(nav);
			initNavHeroTransparency(nav);
			initNavScrollHide(nav);
			initLanguage(nav);

			toggle.addEventListener('click', function () {
				setNavOpen(nav, toggle, !nav.classList.contains('is-open'));
			});

			menu.querySelectorAll('a').forEach(function (link) {
				link.addEventListener('click', function () {
					setNavOpen(nav, toggle, false);
				});
			});

			menu.querySelectorAll('[data-inquiry-open]').forEach(function (button) {
				button.addEventListener('click', function () {
					setNavOpen(nav, toggle, false);
				});
			});

			window.addEventListener('resize', function () {
				if (window.innerWidth > 1100 && nav.classList.contains('is-open')) setNavOpen(nav, toggle, false);
				var languageRoot = nav.querySelector('[data-nav-language]');
				if (languageRoot) languageRoot.classList.remove('is-open');
			});
			document.addEventListener('keydown', function (e) {
				if (e.key === 'Tab' && nav.classList.contains('is-open')) {
					var items = Array.from(nav.querySelectorAll('a, button')).filter(function (el) { return el.getClientRects().length > 0; });
					var first = items[0], last = items[items.length - 1];
					if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
					else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
				}
				if (e.key === 'Escape' && nav.classList.contains('is-open')) {
					setNavOpen(nav, toggle, false);
				}
			});
		}

		function boot() {
			document.querySelectorAll('[data-nav]').forEach(initNav);
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', boot);
		} else {
			boot();
		}
	})();
</script>
