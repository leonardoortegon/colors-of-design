---
import { site } from '../data/site';
import { copy } from '../i18n/ui';
import { getLocale, type Locale } from '../i18n/locale';

interface Props {
	headingLevel?: 'h1' | 'h2';
	id?: string;
	locale?: Locale;
	heading?: string;
	copyText?: string;
	showCopy?: boolean;
}

const {
	headingLevel = 'h2',
	id,
	locale = getLocale(Astro.url.pathname),
	heading,
	copyText,
	showCopy = true,
} = Astro.props;
const HeadingTag = headingLevel;
const t = copy(locale);
const resolvedHeading = heading ?? t.inquiryHeading;
const resolvedCopy = copyText ?? t.inquiryCopy;
---

<div class="inquiry-form-intro">
	<HeadingTag id={id} class="inquiry-form-intro__heading">{resolvedHeading}</HeadingTag>
	<p class="inquiry-form-intro__phone">
		<a href={site.phoneHref}>{site.phone}</a>
	</p>
	{showCopy && <p class="inquiry-form-intro__copy">{resolvedCopy}</p>}
</div>

<style>
	.inquiry-form-intro {
		display: flex;
		flex-direction: column;
		gap: clamp(1.25rem, 2.5vw, 1.5rem);
		text-align: left;
	}

	.inquiry-form-intro__heading {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 3.5vw, 3rem);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--color-text);
		margin: 0;
	}

	.inquiry-form-intro__phone {
		margin: -0.75rem 0 0;
		font-family: var(--font-body);
		font-size: 0.875rem;
		font-weight: 400;
		letter-spacing: 0.02em;
		color: var(--color-text);
		white-space: nowrap;
	}

	.inquiry-form-intro__phone a {
		color: inherit;
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	.inquiry-form-intro__phone a:hover {
		opacity: 0.7;
	}

	.inquiry-form-intro__copy {
		font-family: var(--font-body);
		font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
		line-height: 1.75;
		color: var(--color-text-muted);
		margin: 0;
	}
</style>
