---
import { inquiryFormIntro, site } from '../data/site';

interface Props {
	headingLevel?: 'h1' | 'h2';
	id?: string;
}

const { headingLevel = 'h2', id } = Astro.props;
const HeadingTag = headingLevel;
---

<div class="inquiry-form-intro">
	<p class="eyebrow inquiry-form-intro__phone">
		<a href={site.phoneHref}>{site.phone}</a>
	</p>
	<HeadingTag id={id} class="inquiry-form-intro__heading">{inquiryFormIntro.heading}</HeadingTag>
	<p class="inquiry-form-intro__copy">{inquiryFormIntro.copy}</p>
</div>

<style>
	.inquiry-form-intro {
		display: flex;
		flex-direction: column;
		gap: clamp(1.25rem, 2.5vw, 1.5rem);
		text-align: left;
	}

	.inquiry-form-intro__phone {
		margin: 0;
	}

	.inquiry-form-intro__phone a {
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.inquiry-form-intro__phone a:hover {
		color: var(--color-text);
	}

	.inquiry-form-intro__heading {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 3.5vw, 3rem);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	.inquiry-form-intro__copy {
		font-family: var(--font-body);
		font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
		line-height: 1.75;
		color: var(--color-text-muted);
		margin: 0;
	}
</style>
