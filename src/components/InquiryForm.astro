---
import { site } from '../data/site';
import { copy } from '../i18n/ui';
import { getLocale, type Locale } from '../i18n/locale';

interface Props {
	simple?: boolean;
	submitLabel?: string;
	idPrefix?: string;
	showPrivacyNote?: boolean;
	locale?: Locale;
}

const {
	simple = false,
	idPrefix = '',
	locale = getLocale(Astro.url.pathname),
	submitLabel,
	showPrivacyNote = simple,
} = Astro.props;

const t = copy(locale);
const resolvedSubmit = submitLabel ?? (simple ? t.sendMessage : t.prepareDraft);
const fieldId = (name: string) => `${idPrefix}${name}`;
---

{
	simple ? (
		<form class="inquiry-form inquiry-form--simple" data-inquiry-form data-inquiry-simple data-recipient={site.email} data-mail-hello={t.mailHello} data-mail-name={t.mailName} data-mail-phone={t.mailPhone} data-subject-from={t.mailSubjectFrom('__NAME__')}>
			<div>
				<label for={fieldId('inquiry-name')}>{t.name}</label>
				<input id={fieldId('inquiry-name')} name="name" autocomplete="name" required maxlength="100" />
			</div>
			<div>
				<label for={fieldId('inquiry-phone')}>{t.phone}</label>
				<input id={fieldId('inquiry-phone')} name="phone" type="tel" autocomplete="tel" required maxlength="40" />
			</div>
			<div>
				<label for={fieldId('inquiry-message')}>{t.message}</label>
				<textarea id={fieldId('inquiry-message')} name="message" rows="4" required maxlength="1800" />
			</div>
			<button class="inquiry-form__button" type="submit">{resolvedSubmit}</button>
			{showPrivacyNote && <p class="inquiry-form__privacy">{t.privacyNote}</p>}
		</form>
	) : (
		<form
			class="inquiry-form"
			data-inquiry-form
			data-recipient={site.email}
			data-mail-hello={t.mailHello}
			data-mail-name={t.mailName}
			data-mail-phone={t.mailPhone}
			data-mail-email={t.mailEmail}
			data-mail-location={t.mailLocation}
			data-mail-service={t.mailService}
			data-not-provided={t.notProvided}
			data-to-discuss={t.toDiscuss}
			data-draft-ready={t.draftReady}
			data-draft-copied={t.draftCopied}
			data-select-copy={t.selectCopy}
			data-subject-prefix={t.mailSubject('__DETAIL__')}
		>
			<div class="inquiry-form__pair">
				<div>
					<label for="inquiry-name">{t.name} <span>{t.required}</span></label>
					<input id="inquiry-name" name="name" autocomplete="name" required maxlength="100" />
				</div>
				<div>
					<label for="inquiry-email">{t.email} <span>{t.required}</span></label>
					<input id="inquiry-email" name="email" type="email" autocomplete="email" required maxlength="160" />
				</div>
			</div>
			<div class="inquiry-form__pair">
				<div>
					<label for="inquiry-phone">{t.phone} <span>{t.optional}</span></label>
					<input id="inquiry-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
				</div>
				<div>
					<label for="inquiry-location">{t.projectLocation}</label>
					<input id="inquiry-location" name="location" placeholder={t.cityState} maxlength="150" />
				</div>
			</div>
			<div>
				<label for="inquiry-service">{t.howCanWeHelp}</label>
				<select id="inquiry-service" name="service">
					<option value={t.serviceExplore}>{t.serviceExplore}</option>
					<option>{t.serviceFull}</option>
					<option>{t.serviceReno}</option>
					<option>{t.serviceFurniture}</option>
					<option>{t.serviceTurnkey}</option>
					<option>{t.serviceConsult}</option>
				</select>
			</div>
			<div>
				<label for="inquiry-message">{t.tellUsProject} <span>{t.required}</span></label>
				<textarea
					id="inquiry-message"
					name="message"
					rows="4"
					required
					maxlength="1800"
					placeholder={t.visionPlaceholder}
				/>
			</div>
			<p class="inquiry-form__note" id="inquiry-help">
				{t.prepareNote}
			</p>
			<button class="inquiry-form__button" type="submit" disabled aria-describedby="inquiry-help">
				{resolvedSubmit}
			</button>
			<div class="inquiry-form__draft" data-draft-panel hidden>
				<p role="status" data-draft-status>
					{t.draftReady}
				</p>
				<label for="inquiry-draft">{t.yourDraft}</label>
				<textarea id="inquiry-draft" data-draft-text readonly rows="9" />
				<a class="inquiry-form__button" data-draft-link href={`mailto:${site.email}`}>{t.openEmail}</a>
				<button class="text-link" type="button" data-copy-draft>{t.copyDraft}</button>
				<p class="inquiry-form__note">
					{t.sendTo} <a href={`mailto:${site.email}`}>{site.email}</a>. {t.notSent}
				</p>
			</div>
			<noscript>
				<p>
					{t.emailDirectly} <a href={`mailto:${site.email}`}>{site.email}</a>, {t.orCall}{' '}
					<a href={site.phoneHref}>{site.phone}</a>.
				</p>
			</noscript>
		</form>
	)
}

<style>
	.inquiry-form {
		display: grid;
		gap: 1.75rem;
	}

	.inquiry-form__pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}

	label {
		display: block;
		font-size: 0.6875rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 0.5rem;
	}

	label span {
		font-weight: 400;
		color: var(--color-text-muted);
	}

	input,
	textarea,
	select {
		width: 100%;
		color: var(--color-text);
		background: transparent;
		font: inherit;
		font-size: 1rem;
		padding: 0.75rem 0;
		border: 0;
		border-bottom: 1px solid #aaa59b;
		border-radius: 0;
	}

	textarea {
		resize: vertical;
	}

	select {
		padding-right: 1rem;
	}

	.inquiry-form__button {
		display: block;
		text-align: center;
		padding: 1rem;
		border: 1px solid var(--color-text);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		transition: background 0.2s;
	}

	.inquiry-form__button:hover {
		background: #ece6dc;
	}

	.inquiry-form--simple .inquiry-form__button {
		color: #ffffff;
		background-color: var(--color-text);
		border-color: var(--color-text);
		padding: 0.875rem 2rem;
		font-size: 0.8125rem;
		letter-spacing: 0.12em;
	}

	.inquiry-form--simple .inquiry-form__button:hover {
		color: #ffffff;
		background-color: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
	}

	.inquiry-form__privacy {
		margin: 0;
		font-size: 0.75rem;
		line-height: 1.6;
		color: var(--color-text-muted);
		opacity: 0.85;
	}

	.inquiry-form__note {
		font-size: 0.75rem;
		line-height: 1.8;
		color: var(--color-text-muted);
	}

	.inquiry-form__note a {
		text-decoration: underline;
	}

	.inquiry-form__draft {
		padding: 1.5rem;
		border: 1px solid #c5b9a5;
		background: white;
	}

	.inquiry-form__draft > p:first-child {
		margin-bottom: 1rem;
		font-size: 0.9rem;
	}

	.inquiry-form__draft textarea {
		margin-bottom: 1.25rem;
	}

	.inquiry-form__draft .inquiry-form__note {
		margin-top: 1rem;
	}

	@media (max-width: 540px) {
		.inquiry-form__pair {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLFormElement>('[data-inquiry-form]').forEach((form) => {
		const isSimple = form.hasAttribute('data-inquiry-simple');

		if (isSimple) {
			form.addEventListener('submit', (event) => {
				event.preventDefault();
				if (!form.reportValidity()) return;

				const data = new FormData(form);
				const value = (key: string) => String(data.get(key) || '').trim();
				const subjectTemplate = form.dataset.subjectFrom || 'Project inquiry from __NAME__';
				const subject = subjectTemplate.replace('__NAME__', value('name'));
				const hello = form.dataset.mailHello || 'Hello Colors of Design,';
				const nameLabel = form.dataset.mailName || 'Name';
				const phoneLabel = form.dataset.mailPhone || 'Phone';
				const body = `${hello}\n\n${value('message')}\n\n${nameLabel}: ${value('name')}\n${phoneLabel}: ${value('phone')}`;
				window.location.href = `mailto:${form.dataset.recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			});
			return;
		}

		const panel = form.querySelector<HTMLElement>('[data-draft-panel]')!;
		const draft = form.querySelector<HTMLTextAreaElement>('[data-draft-text]')!;
		const link = form.querySelector<HTMLAnchorElement>('[data-draft-link]')!;
		const status = form.querySelector<HTMLElement>('[data-draft-status]')!;

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;

			const data = new FormData(form);
			const value = (key: string) => String(data.get(key) || '').trim();
			if (!value('name') || !value('message')) {
				form.querySelector<HTMLTextAreaElement>('#inquiry-message')?.focus();
				return;
			}

			const subjectTemplate = form.dataset.subjectPrefix || 'Project inquiry: __DETAIL__';
			const subject = subjectTemplate.replace('__DETAIL__', value('location') || value('service'));
			const hello = form.dataset.mailHello || 'Hello Colors of Design,';
			const body = `${hello}\n\n${value('message')}\n\n${form.dataset.mailName || 'Name'}: ${value('name')}\n${form.dataset.mailEmail || 'Email'}: ${value('email')}\n${form.dataset.mailPhone || 'Phone'}: ${value('phone') || form.dataset.notProvided || 'Not provided'}\n${form.dataset.mailLocation || 'Location'}: ${value('location') || form.dataset.toDiscuss || 'To discuss'}\n${form.dataset.mailService || 'Service'}: ${value('service')}`;
			draft.value = `To: ${form.dataset.recipient}\nSubject: ${subject}\n\n${body}`;
			link.href = `mailto:${form.dataset.recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			status.textContent = form.dataset.draftReady || 'Your draft is ready. Open your email app to send it, or copy the text below.';
			panel.hidden = false;
			link.focus();
		});

		form.querySelector('[data-copy-draft]')?.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(draft.value);
				status.textContent = form.dataset.draftCopied || 'Draft copied. Paste it into your email app, review, and send.';
			} catch {
				draft.focus();
				draft.select();
				status.textContent = form.dataset.selectCopy || 'Select and copy the draft, then paste it into your email app.';
			}
		});

		form.addEventListener('input', () => {
			panel.hidden = true;
		});
		form.querySelector<HTMLButtonElement>('[type=submit]')!.disabled = false;
	});
</script>
