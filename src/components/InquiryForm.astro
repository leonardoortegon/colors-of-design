---
import { site } from '../data/site';
import { copy } from '../i18n/ui';
import { getLocale, type Locale } from '../i18n/locale';

interface Props {
	simple?: boolean;
	submitLabel?: string;
	idPrefix?: string;
	showPrivacyNote?: boolean;
	locale?: Locale;
	source?: string;
}

const {
	simple = false,
	idPrefix = '',
	locale = getLocale(Astro.url.pathname),
	submitLabel,
	showPrivacyNote = simple,
	source = simple ? 'contact' : 'inquiry',
} = Astro.props;

const t = copy(locale);
const resolvedSubmit = submitLabel ?? t.sendMessage;
const fieldId = (name: string) => `${idPrefix}${name}`;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

{
	simple ? (
		<form
			class="inquiry-form inquiry-form--simple"
			data-inquiry-form
			data-inquiry-simple
			data-contact-endpoint="/api/contact/"
			data-source={source}
			data-sending={t.sending}
			data-success={t.sendSuccess}
			data-error={t.sendError}
		>
			<div class="inquiry-form__honeypot" aria-hidden="true">
				<label for={fieldId('inquiry-website')}>Website</label>
				<input
					id={fieldId('inquiry-website')}
					name="website"
					type="text"
					tabindex="-1"
					autocomplete="off"
				/>
			</div>
			<div>
				<label for={fieldId('inquiry-name')}>{t.name}</label>
				<input id={fieldId('inquiry-name')} name="name" autocomplete="name" required maxlength="100" />
			</div>
			<div>
				<label for={fieldId('inquiry-email')}>{t.email}</label>
				<input
					id={fieldId('inquiry-email')}
					name="email"
					type="email"
					autocomplete="email"
					required
					maxlength="160"
				/>
			</div>
			<div>
				<label for={fieldId('inquiry-phone')}>{t.phone}</label>
				<input id={fieldId('inquiry-phone')} name="phone" type="tel" autocomplete="tel" required maxlength="40" />
			</div>
			<div>
				<label for={fieldId('inquiry-message')}>{t.message}</label>
				<textarea id={fieldId('inquiry-message')} name="message" rows="4" required maxlength="1800" />
			</div>
			{turnstileSiteKey && (
				<div
					class="cf-turnstile inquiry-form__security"
					data-sitekey={turnstileSiteKey}
					data-action="contact_form"
					data-appearance="interaction-only"
					data-size="flexible"
					data-theme="light"
				></div>
			)}
			<button class="inquiry-form__button" type="submit" data-submit-button>{resolvedSubmit}</button>
			<p class="inquiry-form__status" data-form-status role="status" hidden></p>
			{showPrivacyNote && <p class="inquiry-form__privacy">{t.privacyNote}</p>}
		</form>
	) : (
		<form
			class="inquiry-form"
			data-inquiry-form
			data-contact-endpoint="/api/contact/"
			data-source={source}
			data-sending={t.sending}
			data-success={t.sendSuccess}
			data-error={t.sendError}
		>
			<div class="inquiry-form__honeypot" aria-hidden="true">
				<label for="inquiry-website">Website</label>
				<input id="inquiry-website" name="website" type="text" tabindex="-1" autocomplete="off" />
			</div>
			<div class="inquiry-form__pair">
				<div>
					<label for="inquiry-name">{t.name} <span>{t.required}</span></label>
					<input id="inquiry-name" name="name" autocomplete="name" required maxlength="100" />
				</div>
				<div>
					<label for="inquiry-email">{t.email} <span>{t.required}</span></label>
					<input id="inquiry-email" name="email" type="email" autocomplete="email" required maxlength="160" />
				</div>
			</div>
			<div class="inquiry-form__pair">
				<div>
					<label for="inquiry-phone">{t.phone} <span>{t.optional}</span></label>
					<input id="inquiry-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
				</div>
				<div>
					<label for="inquiry-location">{t.projectLocation}</label>
					<input id="inquiry-location" name="location" placeholder={t.cityState} maxlength="150" />
				</div>
			</div>
			<div>
				<label for="inquiry-service">{t.howCanWeHelp}</label>
				<select id="inquiry-service" name="service">
					<option value={t.serviceExplore}>{t.serviceExplore}</option>
					<option>{t.serviceFull}</option>
					<option>{t.serviceReno}</option>
					<option>{t.serviceFurniture}</option>
					<option>{t.serviceTurnkey}</option>
					<option>{t.serviceConsult}</option>
				</select>
			</div>
			<div>
				<label for="inquiry-message">{t.tellUsProject} <span>{t.required}</span></label>
				<textarea
					id="inquiry-message"
					name="message"
					rows="4"
					required
					maxlength="1800"
					placeholder={t.visionPlaceholder}
				/>
			</div>
			{turnstileSiteKey && (
				<div
					class="cf-turnstile inquiry-form__security"
					data-sitekey={turnstileSiteKey}
					data-action="contact_form"
					data-appearance="interaction-only"
					data-size="flexible"
					data-theme="light"
				></div>
			)}
			<button class="inquiry-form__button" type="submit" data-submit-button>
				{resolvedSubmit}
			</button>
			<p class="inquiry-form__status" data-form-status role="status" hidden></p>
			<p class="inquiry-form__note">
				{t.formNote}
			</p>
			<noscript>
				<p>
					{t.emailDirectly} <a href={`mailto:${site.email}`}>{site.email}</a>, {t.orCall}{' '}
					<a href={site.phoneHref}>{site.phone}</a>.
				</p>
			</noscript>
		</form>
	)
}

<style>
	.inquiry-form {
		display: grid;
		gap: 1.75rem;
	}

	.inquiry-form__pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}

	.inquiry-form__honeypot {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	label {
		display: block;
		font-size: 0.6875rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: 0.5rem;
	}

	label span {
		font-weight: 400;
		color: var(--color-text-muted);
	}

	input,
	textarea,
	select {
		width: 100%;
		color: var(--color-text);
		background: transparent;
		font: inherit;
		font-size: 1rem;
		padding: 0.75rem 0;
		border: 0;
		border-bottom: 1px solid #aaa59b;
		border-radius: 0;
	}

	textarea {
		resize: vertical;
	}

	select {
		padding-right: 1rem;
	}

	.inquiry-form__button {
		display: block;
		text-align: center;
		padding: 1rem;
		border: 1px solid var(--color-text);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		transition: background 0.2s, opacity 0.2s;
	}

	.inquiry-form__security {
		width: min(100%, 300px);
		justify-self: center;
	}

	.inquiry-form__button:hover:not(:disabled) {
		background: #ece6dc;
	}

	.inquiry-form__button:disabled {
		opacity: 0.65;
		cursor: wait;
	}

	.inquiry-form--simple .inquiry-form__button {
		color: #ffffff;
		background-color: var(--color-text);
		border-color: var(--color-text);
		padding: 0.875rem 2rem;
		font-size: 0.8125rem;
		letter-spacing: 0.12em;
	}

	.inquiry-form--simple .inquiry-form__button:hover:not(:disabled) {
		color: #ffffff;
		background-color: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
	}

	.inquiry-form__privacy {
		margin: 0;
		font-size: 0.75rem;
		line-height: 1.6;
		color: var(--color-text-muted);
		opacity: 0.85;
	}

	.inquiry-form__note {
		font-size: 0.75rem;
		line-height: 1.8;
		color: var(--color-text-muted);
	}

	.inquiry-form__note a {
		text-decoration: underline;
	}

	.inquiry-form__status {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.inquiry-form__status[data-state='success'] {
		color: #2f5d3a;
	}

	.inquiry-form__status[data-state='error'] {
		color: #8a2f2f;
	}

	@media (max-width: 540px) {
		.inquiry-form__pair {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}
	}
</style>

<script>
	async function submitInquiry(form: HTMLFormElement) {
		const endpoint = form.dataset.contactEndpoint || '/api/contact/';
		const button = form.querySelector<HTMLButtonElement>('[data-submit-button]');
		const status = form.querySelector<HTMLElement>('[data-form-status]');
		const defaultLabel = button?.textContent || '';

		const data = new FormData(form);
		const value = (key: string) => String(data.get(key) || '').trim();

		const payload = {
			name: value('name'),
			email: value('email'),
			phone: value('phone'),
			location: value('location'),
			service: value('service'),
			message: value('message'),
			website: value('website'),
			startedAt: Number(form.dataset.startedAt || 0),
			turnstileToken: value('cf-turnstile-response'),
			source: form.dataset.source || 'website',
		};

		if (button) {
			button.disabled = true;
			button.textContent = form.dataset.sending || 'Sending…';
		}
		if (status) {
			status.hidden = true;
			status.removeAttribute('data-state');
			status.textContent = '';
		}

		try {
			const response = await fetch(endpoint, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
				body: JSON.stringify(payload),
			});
			const result = (await response.json().catch(() => ({}))) as {
				ok?: boolean;
				error?: string;
				detail?: string;
			};

			if (!response.ok || !result.ok) {
				throw new Error(
					result.detail || result.error || form.dataset.error || 'Unable to send your message.',
				);
			}

			form.reset();
			form.dataset.startedAt = String(Date.now());
			const turnstile = (window as Window & {
				turnstile?: { reset: (container?: string | HTMLElement) => void };
			}).turnstile;
			const turnstileContainer = form.querySelector<HTMLElement>('.cf-turnstile');
			if (turnstile && turnstileContainer) turnstile.reset(turnstileContainer);
			if (status) {
				status.hidden = false;
				status.dataset.state = 'success';
				status.textContent = form.dataset.success || 'Thank you. Your message has been sent.';
			}
		} catch (error) {
			const turnstile = (window as Window & {
				turnstile?: { reset: (container?: string | HTMLElement) => void };
			}).turnstile;
			const turnstileContainer = form.querySelector<HTMLElement>('.cf-turnstile');
			if (turnstile && turnstileContainer) turnstile.reset(turnstileContainer);
			if (status) {
				status.hidden = false;
				status.dataset.state = 'error';
				status.textContent =
					error instanceof Error ? error.message : form.dataset.error || 'Unable to send your message.';
			}
		} finally {
			if (button) {
				button.disabled = false;
				button.textContent = defaultLabel;
			}
		}
	}

	document.querySelectorAll<HTMLFormElement>('[data-inquiry-form]').forEach((form) => {
		form.dataset.startedAt = String(Date.now());
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			if (!form.reportValidity()) return;
			void submitInquiry(form);
		});
	});
</script>
