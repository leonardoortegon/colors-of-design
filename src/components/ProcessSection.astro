---
export interface ProcessStep {
	title: string;
	description: string;
}

interface Props {
	heading: string;
	steps: ProcessStep[];
	linkLabel: string;
}

const { heading, steps, linkLabel } = Astro.props;
---

<section class="process" id="process" aria-labelledby="process-heading" data-nav-surface="earth">
	<div class="process__inner">
		<h2 id="process-heading" class="process__heading">{heading}</h2>

		<div class="process__grid">
			{steps.map((item) => (
				<article class="process__step">
					<h3 class="process__step-title">{item.title}</h3>
					<p class="process__step-description">{item.description}</p>
				</article>
			))}
		</div>

		<div class="process__footer">
			<button type="button" class="process__link">{linkLabel}</button>
		</div>
	</div>
</section>

<style>
	.process {
		width: 100%;
		background-color: var(--color-earth);
	}

	.process__inner {
		width: 100%;
		max-width: var(--hero-max-width);
		margin-inline: auto;
		padding: clamp(4rem, 8vw, 7rem) var(--site-gutter);
	}

	.process__heading {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 3.5vw, 3rem);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--color-text);
		margin-bottom: clamp(4rem, 8vw, 6rem);
		text-align: center;
	}

	.process__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: clamp(1.5rem, 3vw, 2.5rem);
	}

	.process__step {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
		max-width: 17rem;
		margin-inline: auto;
		text-align: left;
	}

	.process__step-title {
		font-family: var(--font-heading);
		font-size: clamp(1.375rem, 2vw, 1.625rem);
		font-weight: 400;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--color-text);
	}

	.process__step-description {
		font-family: var(--font-body);
		font-size: clamp(0.875rem, 1vw, 0.9375rem);
		line-height: 1.7;
		color: var(--color-text-muted);
	}

	.process__footer {
		display: flex;
		justify-content: center;
		margin-top: clamp(3rem, 6vw, 4.5rem);
	}

	.process__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.875rem 2rem;
		font-family: var(--font-body);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-text);
		background-color: transparent;
		border: 1px solid var(--color-accent);
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.process__link:hover {
		color: var(--color-accent-hover);
		border-color: var(--color-accent-hover);
	}

	@media (max-width: 1024px) {
		.process__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.process__grid {
			grid-template-columns: 1fr;
			gap: clamp(5.5rem, 12vw, 9rem);
		}

		.process__step {
			max-width: none;
		}
	}
</style>
